---
const isHirePage = Astro.url.pathname.replace(/\/+$/, "") === "/hire";
---

{!isHirePage && (
  <a class="hire-float" href="/hire" aria-label="Hire Akshit">
    <span class="hire-float__status" aria-hidden="true"></span>
    <span class="hire-float__label">Have a project?</span>
    <span class="hire-float__action">
      Hire me
      <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M4 10h12m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
  </a>
)}

<style>
  .hire-float {
    position: fixed;
    z-index: 50;
    right: 1.25rem;
    top: 50%;
    display: flex;
    width: 3.5rem;
    min-height: 12.5rem;
    transform: translateY(-50%);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    padding: 1rem 0.65rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-paper) 88%, transparent);
    color: var(--color-ink);
    text-decoration: none;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.1);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    transition: border-color 180ms ease, background-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .hire-float:hover {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: white;
    transform: translateY(-50%) translateX(-3px);
  }

  .hire-float:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .hire-float__status {
    width: 0.48rem;
    height: 0.48rem;
    flex: none;
    border-radius: 999px;
    background: #22c55e;
    box-shadow: 0 0 0 4px color-mix(in srgb, #22c55e 18%, transparent);
  }

  .hire-float__label {
    color: var(--color-muted);
    font-size: 0.61rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    transition: color 180ms ease;
  }

  .hire-float:hover .hire-float__label {
    color: rgba(255, 255, 255, 0.72);
  }

  .hire-float__action {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1;
    white-space: nowrap;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .hire-float__action svg {
    width: 1rem;
    height: 1rem;
    transform: rotate(90deg);
  }

  @media (max-width: 767px) {
    .hire-float {
      top: auto;
      right: 1rem;
      bottom: calc(1rem + env(safe-area-inset-bottom));
      width: auto;
      min-height: 0;
      transform: none;
      flex-direction: row;
      gap: 0.65rem;
      padding: 0.72rem 0.95rem;
      border-radius: 999px;
    }

    .hire-float:hover {
      transform: translateY(-2px);
    }

    .hire-float__label {
      display: none;
    }

    .hire-float__action {
      font-family: var(--font-body);
      font-size: 0.82rem;
      font-weight: 600;
      writing-mode: horizontal-tb;
      transform: none;
    }

    .hire-float__action svg {
      width: 0.9rem;
      height: 0.9rem;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hire-float,
    .hire-float:hover {
      transition: none;
      transform: translateY(-50%);
    }
  }

  @media (max-width: 767px) and (prefers-reduced-motion: reduce) {
    .hire-float,
    .hire-float:hover {
      transform: none;
    }
  }
</style>
