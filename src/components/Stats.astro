---
import { featured, more } from "../data/projects";

const all = [...featured, ...more];
const stats = [
  { value: all.length, label: "things shipped", pop: "red" },
  { value: all.filter((p) => p.links.some((l) => l.href.includes("github.com"))).length, label: "with public code", pop: "blue" },
  { value: all.filter((p) => /iOS|macOS|watchOS/.test(p.tag)).length, label: "for Apple devices", pop: "green" },
  { value: "∞", label: "ideas in the backlog", pop: "purple" },
];
---

<ul class="stats" data-reveal>
  {stats.map((stat, i) => (
    <li class="stat" style={`--pop: var(--pop-${stat.pop}); --on: var(--on-${stat.pop === "blue" ? "blue" : "pop"}); --r: ${i % 2 ? 1.5 : -1.5}deg`}>
      <strong data-count={typeof stat.value === "number" ? stat.value : undefined}>{stat.value}</strong>
      <span>{stat.label}</span>
    </li>
  ))}
</ul>

<script>
  // Count the numbers up the first time the tiles scroll into view.
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const numbers = document.querySelectorAll<HTMLElement>("[data-count]");

  if (!reducedMotion.matches) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        observer.unobserve(entry.target);
        const el = entry.target as HTMLElement;
        const target = Number(el.dataset.count);
        const start = performance.now();
        const step = (now: number) => {
          const t = Math.min(1, (now - start) / 1200);
          el.textContent = String(Math.round(target * (1 - Math.pow(1 - t, 3))));
          if (t < 1) requestAnimationFrame(step);
        };
        el.textContent = "0";
        requestAnimationFrame(step);
      }
    }, { threshold: 0.6 });
    numbers.forEach((el) => observer.observe(el));
  }
</script>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    max-width: 76rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .stats { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem; }
  }

  @media (min-width: 64rem) {
    .stats { padding-inline: 3rem; }
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.25rem 1.25rem 1.125rem;
    border: 2px solid var(--color-line);
    border-radius: 1.25rem;
    background: var(--pop);
    box-shadow: 5px 5px 0 var(--color-line);
    color: var(--on);
    rotate: var(--r);
    transition: rotate 300ms cubic-bezier(0.34, 1.56, 0.64, 1), translate 300ms ease;
  }

  .stat:hover { rotate: 0deg; translate: 0 -4px; }

  .stat strong {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 6vw, 4rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  .stat span {
    font-size: 0.9375rem;
    font-weight: 600;
  }

  @media (prefers-reduced-motion: reduce) {
    .stat { transition: none; }
  }
</style>
