---
import { avatarUrl } from "../data/socials";

const links = [
  { label: "Work", href: "#projects", pop: "yellow", tilt: "-3deg" },
  { label: "Drawer", href: "#junk-drawer", pop: "pink", tilt: "3deg" },
  { label: "Say hi", href: "#hi", pop: "green", tilt: "-2deg" },
];
---

<nav class="nav animate-fade-up" aria-label="Site">
  <a href="#top" class="nav-home">
    <img src={avatarUrl} alt="" width="28" height="28" />
    <span>Akshit</span>
  </a>
  <span class="nav-divider" aria-hidden="true"></span>
  {links.map((link) => (
    <a href={link.href} class="nav-link" style={`--hover: var(--pop-${link.pop}); --tilt: ${link.tilt}`}>{link.label}</a>
  ))}
</nav>

<style>
  .nav {
    position: fixed;
    top: max(1rem, env(safe-area-inset-top));
    left: max(1rem, env(safe-area-inset-left));
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 0.125rem;
    height: 2.75rem;
    padding: 0 0.375rem;
    border: 2px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-card);
    box-shadow: 3px 3px 0 var(--color-line);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2rem;
    padding: 0 0.75rem;
    border-radius: 999px;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 150ms ease, color 150ms ease, transform 150ms ease;
  }

  .nav-home {
    padding-left: 0.125rem !important;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1rem;
  }

  .nav-home img {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 999px;
    border: 2px solid var(--color-line);
    object-fit: cover;
  }

  .nav-divider {
    width: 2px;
    height: 1.25rem;
    margin: 0 0.25rem;
    border-radius: 2px;
    background: var(--color-border-strong);
  }

  .nav-link:hover {
    background: var(--hover);
    color: var(--on-pop);
    transform: rotate(var(--tilt));
  }

  @media (max-width: 26rem) {
    .nav-home span { display: none; }
    .nav a { padding: 0 0.625rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav a { transition: none; }
    .nav-link:hover { transform: none !important; }
  }
</style>
