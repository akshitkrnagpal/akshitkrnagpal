<button
	type="button"
	class="theme-toggle"
	data-theme-toggle
	aria-label="Switch color theme"
	title="Switch color theme"
>
	<svg class="theme-toggle__icon theme-toggle__sun" viewBox="0 0 24 24" aria-hidden="true">
		<circle cx="12" cy="12" r="3.75"></circle>
		<path d="M12 2.25v2M12 19.75v2M21.75 12h-2M4.25 12h-2M18.9 5.1l-1.4 1.4M6.5 17.5l-1.4 1.4M18.9 18.9l-1.4-1.4M6.5 6.5 5.1 5.1"></path>
	</svg>
	<svg class="theme-toggle__icon theme-toggle__moon" viewBox="0 0 24 24" aria-hidden="true">
		<path d="M20.25 15.35A8.75 8.75 0 0 1 8.65 3.75a8.75 8.75 0 1 0 11.6 11.6Z"></path>
	</svg>
</button>

<script>
	const storageKey = "theme";
	const colorScheme = window.matchMedia("(prefers-color-scheme: dark)");
	const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
	let isTransitioning = false;

	function savedTheme() {
		try {
			const value = window.localStorage.getItem(storageKey);
			return value === "light" || value === "dark" ? value : null;
		} catch {
			return null;
		}
	}

	function setTheme(theme: "light" | "dark", save = false) {
		document.documentElement.dataset.theme = theme;
		document.documentElement.style.colorScheme = theme;

		if (save) {
			try {
				window.localStorage.setItem(storageKey, theme);
			} catch {
				// The selected theme still applies for the current page.
			}
		}

		const nextTheme = theme === "dark" ? "light" : "dark";
		document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((button) => {
			const label = `Switch to ${nextTheme} mode`;
			button.setAttribute("aria-label", label);
			button.setAttribute("title", label);
		});
	}

	function animateIcons(button: HTMLButtonElement, theme: "light" | "dark") {
		if (reducedMotion.matches) return;
		const direction = theme === "dark" ? 1 : -1;
		button.querySelectorAll<SVGElement>(".theme-toggle__icon").forEach((icon) => {
			const entering = icon.classList.contains("theme-toggle__sun") === (theme === "dark");
			icon.getAnimations().forEach((animation) => animation.cancel());
			icon.animate(
				entering
					? [
						{ opacity: 0, transform: `rotate(${-90 * direction}deg) scale(0.4)` },
						{ opacity: 1, transform: "rotate(0deg) scale(1)" },
					]
					: [
						{ opacity: 1, transform: "rotate(0deg) scale(1)" },
						{ opacity: 0, transform: `rotate(${90 * direction}deg) scale(0.4)` },
					],
				{ duration: 500, easing: "cubic-bezier(0.22, 1, 0.36, 1)" },
			);
		});
	}

	async function toggleTheme(button: HTMLButtonElement) {
		if (isTransitioning) return;
		const root = document.documentElement;
		const nextTheme = root.dataset.theme === "dark" ? "light" : "dark";

		if (reducedMotion.matches || !document.startViewTransition) {
			setTheme(nextTheme, true);
			animateIcons(button, nextTheme);
			return;
		}

		const { left, top, width, height } = button.getBoundingClientRect();
		const x = left + width / 2;
		const y = top + height / 2;
		const radius = Math.hypot(
			Math.max(x, window.innerWidth - x),
			Math.max(y, window.innerHeight - y),
		);

		isTransitioning = true;
		root.dataset.themeTransition = nextTheme;
		const transition = document.startViewTransition(() => setTheme(nextTheme, true));
		let reveal: Animation | undefined;

		try {
			await transition.ready;
			animateIcons(button, nextTheme);
			const circle = [
				`circle(${width / 2}px at ${x}px ${y}px)`,
				`circle(${radius}px at ${x}px ${y}px)`,
			];
			reveal = root.animate(
				{
					clipPath: nextTheme === "light" ? circle : circle.reverse(),
				},
				{
					duration: 650,
					// Keep the final mask until the browser removes the snapshots.
					fill: "forwards",
					easing: "cubic-bezier(0.4, 0, 0.2, 1)",
					pseudoElement: nextTheme === "light"
						? "::view-transition-new(root)"
						: "::view-transition-old(root)",
				},
			);
			await reveal.finished;
		} catch {
			// A skipped transition still needs to apply the selected theme.
			transition.skipTransition();
			setTheme(nextTheme, true);
		} finally {
			await transition.finished;
			// Filled animations survive their snapshots and can affect the next toggle.
			reveal?.cancel();
			delete root.dataset.themeTransition;
			isTransitioning = false;
		}
	}

	function setupThemeToggle() {
		const theme = document.documentElement.dataset.theme === "dark" ? "dark" : "light";
		setTheme(theme);

		document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((button) => {
			button.addEventListener("click", () => toggleTheme(button));
		});
	}

	colorScheme.addEventListener("change", (event) => {
		if (!savedTheme()) setTheme(event.matches ? "dark" : "light");
	});

	window.addEventListener("storage", (event) => {
		if (event.key !== storageKey) return;
		const theme = event.newValue === "light" || event.newValue === "dark"
			? event.newValue
			: colorScheme.matches ? "dark" : "light";
		setTheme(theme);
	});

	setupThemeToggle();
</script>

<style>
	.theme-toggle {
		position: fixed;
		/* Vertically centered in the 4.75rem homepage navbar. */
		top: max(1rem, env(safe-area-inset-top));
		right: max(1.5rem, env(safe-area-inset-right));
		z-index: 50;
		view-transition-name: theme-toggle;
		display: inline-grid;
		width: 2.75rem;
		height: 2.75rem;
		place-items: center;
		flex: none;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		background: var(--color-paper);
		box-shadow: 0 4px 16px rgb(0 0 0 / 0.08);
		color: var(--color-ink);
		cursor: pointer;
		transition: border-color 180ms ease, background-color 180ms ease, transform 180ms ease;
	}

	.theme-toggle:hover {
		border-color: var(--color-border-strong);
		background: var(--color-surface-hover);
		transform: translateY(-1px);
	}

	.theme-toggle:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
	}

	.theme-toggle__icon {
		grid-area: 1 / 1;
		width: 1rem;
		height: 1rem;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.5;
		transform-origin: center;
	}

	.theme-toggle__sun,
	:global(html[data-theme="dark"]) .theme-toggle__moon {
		opacity: 0;
	}

	.theme-toggle__moon,
	:global(html[data-theme="dark"]) .theme-toggle__sun {
		opacity: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.theme-toggle {
			transition: none;
		}
	}
</style>
