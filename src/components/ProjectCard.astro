---
import { Image } from "astro:assets";
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  index?: number;
  /** Sticker color name from Layout.astro, e.g. "pink". */
  pop?: string;
}

const { project, index = 0, pop = "yellow" } = Astro.props;
const [primary] = project.links;
// Alternate a slight tilt so the grid looks like a pinboard.
const tilt = [-1.25, 0.75, -0.5, 1.25, -1, 0.5][index % 6];
---

<article
  class="card animate-fade-up"
  style={`animation-delay: ${0.4 + index * 0.08}s; --pop: var(--pop-${pop}); --tilt: ${tilt}deg`}
>
  {project.preview && (
    <a href={primary.href} target="_blank" rel="noopener noreferrer" class="card-media" tabindex="-1" aria-hidden="true">
      <Image
        src={project.preview}
        alt=""
        widths={[480, 800, 1200]}
        sizes="(min-width: 64rem) 30rem, (min-width: 44rem) 50vw, 100vw"
      />
    </a>
  )}
  <div class="card-body">
    <span class="card-tag">{project.tag}</span>
    <h3><a href={primary.href} target="_blank" rel="noopener noreferrer">{project.name}</a></h3>
    <p>{project.description}</p>
    <div class="card-links">
      {project.links.map((link) => (
        <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={`${project.name}: ${link.label}`}>
          {link.label}<span aria-hidden="true"> ↗</span>
        </a>
      ))}
    </div>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 2px solid var(--color-ink);
    border-radius: 1.125rem;
    background: var(--color-card);
    box-shadow: 6px 6px 0 var(--pop);
    rotate: var(--tilt);
    transition:
      rotate 300ms cubic-bezier(0.34, 1.56, 0.64, 1),
      translate 300ms cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 300ms ease;
  }

  .card:hover {
    rotate: 0deg;
    translate: -4px -4px;
    box-shadow: 10px 10px 0 var(--pop);
  }

  .card-media {
    display: block;
    overflow: hidden;
    border-bottom: 2px solid var(--color-ink);
    aspect-ratio: 1200 / 630;
  }

  .card-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card:hover .card-media img { transform: scale(1.05); }

  .card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    padding: 1.125rem 1.25rem 1.25rem;
  }

  .card-tag {
    padding: 0.125rem 0.625rem;
    border: 1.5px solid var(--color-ink);
    border-radius: 999px;
    background: var(--pop);
    color: var(--color-on-pop);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  h3 {
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  p {
    flex: 1;
    margin-top: 0.375rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-muted);
  }

  .card-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .card-links a {
    padding: 0.25rem 0.75rem;
    border: 2px solid var(--color-ink);
    border-radius: 999px;
    transition: background-color 150ms ease, color 150ms ease;
  }

  .card-links a:hover {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  a { color: inherit; text-decoration: none; }
  h3 a:hover { text-decoration: underline; text-decoration-color: var(--pop); text-decoration-thickness: 4px; text-underline-offset: 4px; }
  a:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; border-radius: 2px; }

  @media (prefers-reduced-motion: reduce) {
    .card, .card-media img { transition: none; }
    .card:hover .card-media img { transform: none; }
  }
</style>
