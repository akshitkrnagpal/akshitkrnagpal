---
import { Image } from "astro:assets";
import type { Project } from "../data/projects";
import { pops } from "../data/socials";

interface Props {
  project: Project;
  index?: number;
}

const { project, index = 0 } = Astro.props;
const [primary] = project.links;
const pop = pops[index % pops.length];
const domain = new URL(primary.href).hostname.replace(/^www\./, "");
const number = String(index + 1).padStart(2, "0");
---

<article
  class="card"
  data-reveal
  data-tilt
  style={`--pop: var(--pop-${pop}); --on: var(--on-${pop === "blue" ? "blue" : "pop"}); --rest: ${index % 2 ? 1 : -1}deg; transition-delay: ${(index % 3) * 80}ms`}
>
  <div class="card-inner">
    {project.preview && (
      <a href={primary.href} target="_blank" rel="noopener noreferrer" class="card-media" tabindex="-1" aria-hidden="true">
        <span class="browser-bar">
          <span class="browser-dots"><i></i><i></i><i></i></span>
          <span class="browser-url">{domain}</span>
        </span>
        <span class="card-image">
          <Image
            src={project.preview}
            alt=""
            widths={[480, 800, 1200]}
            sizes="(min-width: 64rem) 24rem, (min-width: 44rem) 50vw, 100vw"
          />
        </span>
      </a>
    )}
    <div class="card-body">
      <div class="card-title">
        <span class="card-number" aria-hidden="true">{number}</span>
        <h3><a href={primary.href} target="_blank" rel="noopener noreferrer">{project.name}</a></h3>
      </div>
      <p>{project.description}</p>
      <div class="card-footer">
        <span class="card-tag">{project.tag}</span>
        <div class="card-links">
          {project.links.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={`${project.name}: ${link.label}`}>
              {link.label}<span aria-hidden="true"> ↗</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</article>

<style>
  .card {
    perspective: 900px;
    rotate: var(--rest);
  }

  .card-inner {
    --rx: 0deg;
    --ry: 0deg;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 2px solid var(--color-line);
    border-radius: 1.25rem;
    background: var(--color-card);
    box-shadow: 6px 6px 0 var(--pop), 6px 6px 0 2px var(--color-line);
    transition: transform 400ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 250ms ease, translate 250ms ease;
  }

  .card:hover .card-inner,
  .card:focus-within .card-inner {
    translate: -3px -4px;
    box-shadow: 10px 12px 0 var(--pop), 10px 12px 0 2px var(--color-line);
  }

  /* Only go 3D while tilting, so text stays crisp at rest. */
  .card.is-tilting .card-inner {
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform 80ms linear, box-shadow 250ms ease, translate 250ms ease;
  }

  .card-media {
    display: block;
    border-bottom: 2px solid var(--color-line);
    background: var(--pop);
  }

  .browser-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem;
    border-bottom: 2px solid var(--color-line);
  }

  .browser-dots { display: flex; gap: 0.3125rem; }

  .browser-dots i {
    width: 0.625rem;
    height: 0.625rem;
    border: 1.5px solid #16130f;
    border-radius: 999px;
    background: #fffdf8;
  }

  .browser-url {
    flex: 1;
    min-width: 0;
    padding: 0.0625rem 0.75rem;
    border: 1.5px solid #16130f;
    border-radius: 999px;
    background: #fffdf8;
    color: #16130f;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-align: center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .card-image {
    display: block;
    aspect-ratio: 1200 / 630;
    overflow: hidden;
  }

  .card-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card:hover .card-image img { transform: scale(1.04); }

  .card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.125rem 1.25rem 1.25rem;
  }

  .card-title {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .card-number {
    display: grid;
    place-items: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    border: 2px solid var(--color-line);
    border-radius: 999px;
    background: var(--pop);
    color: var(--on);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
  }

  h3 {
    font-family: var(--font-display);
    font-size: 1.625rem;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  p {
    margin-top: 0.625rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-muted);
  }

  .card-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1rem;
  }

  .card-tag {
    padding: 0.125rem 0.625rem;
    border: 1.5px solid var(--color-line);
    border-radius: 999px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .card-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .card-links a {
    padding: 0.25rem 0.75rem;
    border: 2px solid var(--color-line);
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 700;
    transition: background-color 150ms ease, color 150ms ease;
  }

  .card-links a:hover {
    background: var(--pop);
    color: var(--on);
  }

  a { color: inherit; text-decoration: none; }
  h3 a:hover { text-decoration: underline; text-decoration-thickness: 3px; text-decoration-color: var(--pop); text-underline-offset: 4px; }

  @media (prefers-reduced-motion: reduce) {
    .card { rotate: none; }
    .card-inner, .card-image img, .card-links a { transition: none; }
    .card:hover .card-image img { transform: none; }
  }
</style>
