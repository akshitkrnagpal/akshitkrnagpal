---
import { Image } from "astro:assets";
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  index?: number;
}

const { project, index = 0 } = Astro.props;
const [primary] = project.links;
---

<article class="card animate-fade-up" style={`animation-delay: ${0.15 + index * 0.08}s`}>
  {project.preview && (
    <a href={primary.href} target="_blank" rel="noopener noreferrer" class="card-media" tabindex="-1" aria-hidden="true">
      <Image
        src={project.preview}
        alt=""
        widths={[480, 800, 1200]}
        sizes="(min-width: 64rem) 30rem, (min-width: 44rem) 50vw, 100vw"
        style={`view-transition-name: preview-${project.slug}`}
      />
    </a>
  )}
  <div class="card-body">
    <div class="card-title">
      <h3><a href={primary.href} target="_blank" rel="noopener noreferrer">{project.name}</a></h3>
      <span>{project.tag}</span>
    </div>
    <p>{project.description}</p>
    <div class="card-links">
      {project.links.map((link) => (
        <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={`${project.name}: ${link.label}`}>
          {link.label}<span aria-hidden="true"> ↗</span>
        </a>
      ))}
    </div>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .card-media {
    display: block;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    aspect-ratio: 1200 / 630;
    transition: border-color 200ms ease;
  }

  .card-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card:hover .card-media { border-color: var(--color-border-strong); }
  .card:hover .card-media img { transform: scale(1.03); }

  .card-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  h3 {
    font-family: var(--font-display);
    font-size: 1.625rem;
    font-weight: 400;
    line-height: 1.1;
  }

  .card-title span {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    white-space: nowrap;
  }

  p {
    margin-top: 0.375rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .card-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: 0.625rem;
    font-size: 0.8125rem;
  }

  a { color: inherit; text-decoration: none; }
  .card-links a:hover, h3 a:hover { text-decoration: underline; text-underline-offset: 3px; }
  a:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; border-radius: 2px; }

  @media (prefers-reduced-motion: reduce) {
    .card-media, .card-media img { transition: none; }
    .card:hover .card-media img { transform: none; }
  }
</style>
