---
import { Image } from "astro:assets";
import type { Project } from "../data/projects";
interface Props {
  project: Project;
  index?: number;
}
const { project, index = 0 } = Astro.props;
const [primary] = project.links;
const colors = ["blue", "peach", "lilac", "green", "blue", "peach"];
---

<article
  class={`card card-${colors[index % colors.length]}`}
  data-project
  data-project-name={project.name}
  data-category={project.category}
>
  <div class="card-top">
    <span class="card-number">{String(index + 1).padStart(2, "0")}</span>
    <span class="card-tag">{project.tag}</span>
    <span class="card-spark" aria-hidden="true">
      ✳
    </span>
  </div>
  {project.preview && (
    <a
      href={primary.href}
      target="_blank"
      rel="noopener noreferrer"
      class="card-media"
      tabindex="-1"
      aria-hidden="true"
    >
      <div class="browser-dots" aria-hidden="true">
        <i></i>
        <i></i>
        <i></i>
      </div>
      <Image
        src={project.preview}
        alt=""
        widths={[480, 800, 1200]}
        sizes="(min-width: 64rem) 360px, (min-width: 48rem) 45vw, (min-width: 30rem) 46vw, 100vw"
        loading="lazy"
      />
    </a>
  )}
  <div class="card-body">
    <h3>
      <a
        href={primary.href}
        target="_blank"
        rel="noopener noreferrer"
        data-project-link
      >
        {project.name}
        <span aria-hidden="true">↗</span>
      </a>
    </h3>
    <p>{project.description}</p>
    <div class="card-links">
      {project.links.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${project.name}: ${link.label}`}
        >
          {link.label}
          <span aria-hidden="true"> ↗</span>
        </a>
      ))}
    </div>
  </div>
</article>

<style>
  .card {
    --card-color: var(--color-blue-soft);
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    scroll-margin-top: 30px;
    transition:
      transform 220ms ease,
      box-shadow 220ms ease,
      border-color 220ms ease;
  }
  .card[hidden] {
    display: none;
  }
  .card-peach {
    --card-color: var(--color-peach);
  }
  .card-lilac {
    --card-color: var(--color-lilac);
  }
  .card-green {
    --card-color: var(--color-green);
  }
  .card:hover,
  .card:focus-within {
    transform: translateY(-4px);
    box-shadow: 0 8px 0 var(--color-border);
    border-color: var(--color-border-strong);
  }
  .card.is-picked {
    outline: 2px dashed var(--color-accent);
    outline-offset: 5px;
  }
  .card-top {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 14px 18px 12px;
    background: var(--card-color);
  }
  .card-number {
    font-family: ui-monospace, monospace;
    font-size: 10px;
    color: var(--color-muted);
  }
  .card-tag {
    font-size: 10px;
    color: var(--color-muted);
  }
  .card-spark {
    margin-left: auto;
    color: var(--color-accent);
    font-size: 17px;
    line-height: 1;
  }
  .card-media {
    display: block;
    position: relative;
    margin: 0;
    padding: 4px 18px 21px;
    background: var(--card-color);
  }
  .browser-dots {
    display: flex;
    gap: 4px;
    background: var(--color-surface);
    padding: 8px 10px;
    border: 1px solid var(--color-border);
    border-bottom: 0;
    border-radius: 6px 6px 0 0;
  }
  .browser-dots i {
    width: 4px;
    height: 4px;
    background: var(--color-border-strong);
    border-radius: 50%;
  }
  .card-media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
    border: 1px solid var(--color-border);
    border-radius: 0 0 5px 5px;
    box-shadow: 0 5px 9px rgb(0 0 0 / 0.05);
  }
  .card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 21px 21px 14px;
  }
  h3 {
    font-size: 24px;
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1.2;
  }
  h3 a {
    min-height: 44px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
  }
  h3 span {
    font-size: 18px;
    font-weight: 400;
    color: var(--color-muted);
    transition: transform 180ms ease;
  }
  .card:hover h3 span,
  .card:focus-within h3 span {
    transform: translate(2px, -2px);
    color: var(--color-accent);
  }
  p {
    color: var(--color-muted);
    font-size: 13px;
    line-height: 1.75;
    margin-block: 11px 17px;
  }
  .card-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-top: auto;
    border-top: 1px solid var(--color-border);
    padding-top: 6px;
    font-size: 12px;
  }
  .card-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  .card-links a:hover,
  h3 a:hover {
    color: var(--color-accent);
  }
  a:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 2px;
  }
  @media (max-width: 767px) {
    .card-body {
      padding: 18px 18px 12px;
    }
    .card-top {
      padding-inline: 15px;
    }
    .card-media {
      padding-inline: 15px;
    }
    .card-links a {
      min-height: 44px;
      font-size: 11px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .card,
    h3 span {
      transition: none;
    }
    .card:hover,
    .card:hover h3 span,
    .card:focus-within h3 span {
      transform: none;
    }
  }
</style>
