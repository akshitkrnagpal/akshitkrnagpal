---
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Akshit Kr Nagpal | Senior Software Engineer · AI Systems",
	description = "Senior software engineer expanding into AI engineering through agents, evals, developer tools, and production software.",
} = Astro.props;

const siteUrl = "https://akshit.io";
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonicalUrl = pathname === "/" ? siteUrl : `${siteUrl}${pathname}`;
const ogImageUrl = `${siteUrl}/og.png`;
const avatarUrl = "https://avatars.githubusercontent.com/u/15872348";

const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: "Akshit Kr Nagpal",
	url: siteUrl,
	image: avatarUrl,
	jobTitle: "Senior Software Engineer",
	sameAs: [
		"https://github.com/akshitkrnagpal",
		"https://linkedin.com/in/akshitkrnagpal",
		"https://x.com/akshit_io",
	],
	knowsAbout: ["AI Agent Engineering", "AI Evaluation", "Large Language Models", "Model Context Protocol", "Full-Stack Development", "TypeScript", "Open Source"],
};

const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: "Akshit Kr Nagpal",
	url: siteUrl,
};
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<script is:inline>
			(() => {
				let savedTheme = null;
				try {
					const value = window.localStorage.getItem("theme");
					if (value === "light" || value === "dark") savedTheme = value;
				} catch {
					// Fall back to the operating system preference when storage is unavailable.
				}

				const theme = savedTheme ?? (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
				document.documentElement.dataset.theme = theme;
				document.documentElement.style.colorScheme = theme;
				document.documentElement.classList.add("js");
			})();
		</script>
		<link rel="icon" href="/favicon.ico" sizes="any">
		<link rel="apple-touch-icon" href="/apple-touch-icon.png">
		<link rel="manifest" href="/manifest.json" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Caveat:wght@600&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
		<meta name="generator" content={Astro.generator} />
		<meta name="author" content="Akshit Kr Nagpal" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<!-- Open Graph Meta Tags -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Akshit Kr Nagpal, senior software engineer working across full-stack and AI systems" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<!-- Twitter Card Meta Tags -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@akshit_io" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content="Akshit Kr Nagpal, senior software engineer working across full-stack and AI systems" />
		<!-- Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
		<slot name="head" />
		<script src="https://analytics.ahrefs.com/analytics.js" data-key="qIzc0UIE/OnCN8g4tBDXNQ" async></script>
		<style is:global>
			:root {
				--color-ink: #16130f;
				--color-paper: #fdf6e9;
				--color-muted: #6a6257;
				--color-card: #ffffff;
				--color-line: #16130f;
				--color-border-strong: rgba(22, 19, 15, 0.32);
				--color-dot: rgba(22, 19, 15, 0.09);
				--pop-red: #ff5b35;
				--pop-yellow: #ffc93c;
				--pop-blue: #3d5afe;
				--pop-green: #1fbf87;
				--pop-pink: #ff7ac6;
				--pop-purple: #8e6cff;
				/* Text that sits on a pop color. Blue is too dark for ink in light mode. */
				--on-pop: #16130f;
				--on-blue: #ffffff;
				--font-display: 'Bricolage Grotesque', 'DM Sans', system-ui, sans-serif;
				--font-body: 'DM Sans', system-ui, sans-serif;
				--font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
				--font-hand: 'Caveat', 'Comic Sans MS', cursive;
			}

			html[data-theme="dark"] {
				--color-ink: #f6eedf;
				--color-paper: #14120f;
				--color-muted: #a99f8f;
				--color-card: #1e1b17;
				--color-line: #f6eedf;
				--color-border-strong: rgba(246, 238, 223, 0.32);
				--color-dot: rgba(246, 238, 223, 0.08);
				--pop-red: #ff6a47;
				--pop-yellow: #ffd257;
				--pop-blue: #6f86ff;
				--pop-green: #34d399;
				--pop-pink: #ff8fd0;
				--pop-purple: #a48bff;
				--on-blue: #16130f;
			}

			@media (prefers-color-scheme: dark) {
				:root:not([data-theme]) {
					--color-ink: #f6eedf;
					--color-paper: #14120f;
					--color-muted: #a99f8f;
					--color-card: #1e1b17;
					--color-line: #f6eedf;
					--color-border-strong: rgba(246, 238, 223, 0.32);
					--color-dot: rgba(246, 238, 223, 0.08);
				}
			}

			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			html {
				scroll-behavior: smooth;
				background: var(--color-paper);
			}

			body {
				font-family: var(--font-body);
				background-color: var(--color-paper);
				background-image: radial-gradient(var(--color-dot) 1.2px, transparent 1.2px);
				background-size: 22px 22px;
				color: var(--color-ink);
				line-height: 1.6;
				overflow-x: clip;
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
				transition: background-color 180ms ease, color 180ms ease;
			}

			::selection {
				background: var(--pop-yellow);
				color: var(--on-pop);
			}

			a:focus-visible,
			button:focus-visible,
			input:focus-visible {
				outline: 3px solid var(--pop-blue);
				outline-offset: 3px;
				border-radius: 6px;
			}

			.sr-only {
				position: absolute;
				width: 1px;
				height: 1px;
				padding: 0;
				margin: -1px;
				overflow: hidden;
				clip: rect(0, 0, 0, 0);
				white-space: nowrap;
				border: 0;
			}

			@keyframes fadeUp {
				from {
					opacity: 0;
					transform: translateY(24px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			@keyframes popIn {
				/* Uses transform so the individual scale/rotate properties stay free for hover effects. */
				0% {
					opacity: 0;
					transform: scale(0.6);
				}
				70% {
					opacity: 1;
					transform: scale(1.06);
				}
				100% {
					opacity: 1;
					transform: none;
				}
			}

			.animate-fade-up {
				animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
			}

			.animate-pop-in {
				animation: popIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both;
			}

			.delay-1 { animation-delay: 0.1s; }
			.delay-2 { animation-delay: 0.2s; }
			.delay-3 { animation-delay: 0.3s; }
			.delay-4 { animation-delay: 0.4s; }

			/* Sections pop in once as they scroll into view (see index.astro). */
			.js [data-reveal] {
				opacity: 0;
				transform: translateY(32px);
				transition: opacity 700ms ease, transform 800ms cubic-bezier(0.16, 1, 0.3, 1);
			}

			.js [data-reveal].is-visible {
				opacity: 1;
				transform: none;
			}

			@media (prefers-reduced-motion: reduce) {
				html {
					scroll-behavior: auto;
				}

				body,
				.animate-fade-up,
				.animate-pop-in {
					animation: none !important;
					transition: none;
				}

				.js [data-reveal] {
					opacity: 1;
					transform: none;
					transition: none;
				}
			}
		</style>
	</head>
	<body>
		<ThemeToggle />
		<slot />
	</body>
</html>
