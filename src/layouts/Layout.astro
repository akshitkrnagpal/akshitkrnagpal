---
import "../styles/global.css";
import HireFloat from "../components/HireFloat.astro";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Akshit Kr Nagpal | AI Engineer · Agents & Evals",
	description = "Software engineer building AI agents, eval systems, developer tools, and production products.",
} = Astro.props;

const siteUrl = "https://akshit.io";
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonicalUrl = pathname === "/" ? siteUrl : `${siteUrl}${pathname}`;
const ogImageUrl = `${siteUrl}/og.png`;
const avatarUrl = "https://avatars.githubusercontent.com/u/15872348";

const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: "Akshit Kr Nagpal",
	url: siteUrl,
	image: avatarUrl,
	jobTitle: "AI Engineer",
	sameAs: [
		"https://github.com/akshitkrnagpal",
		"https://linkedin.com/in/akshitkrnagpal",
		"https://x.com/akshit_io",
	],
	knowsAbout: ["AI Agent Engineering", "AI Evaluation", "Large Language Models", "Model Context Protocol", "Full-Stack Development", "TypeScript", "Open Source"],
};

const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: "Akshit Kr Nagpal",
	url: siteUrl,
};
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<script is:inline>
			(() => {
				let savedTheme = null;
				try {
					const value = window.localStorage.getItem("theme");
					if (value === "light" || value === "dark") savedTheme = value;
				} catch {
					// Fall back to the operating system preference when storage is unavailable.
				}

				const theme = savedTheme ?? (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
				document.documentElement.dataset.theme = theme;
				document.documentElement.style.colorScheme = theme;
			})();
		</script>
		<link rel="icon" href="/favicon.ico" sizes="any">
		<link rel="apple-touch-icon" href="/apple-touch-icon.png">
		<link rel="manifest" href="/manifest.json" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap" rel="stylesheet" />
		<meta name="generator" content={Astro.generator} />
		<meta name="author" content="Akshit Kr Nagpal" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<!-- Open Graph Meta Tags -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Akshit Kr Nagpal, AI engineer specializing in agents and evals" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<!-- Twitter Card Meta Tags -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@akshit_io" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content="Akshit Kr Nagpal, AI engineer specializing in agents and evals" />
		<!-- Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
		<slot name="head" />
		<script src="https://analytics.ahrefs.com/analytics.js" data-key="qIzc0UIE/OnCN8g4tBDXNQ" async></script>
		<style>
			:root {
				--color-ink: #1d1c1a;
				--color-paper: #f7f5f1;
				--color-muted: #6d6861;
				--color-accent: #c94f40;
				--color-accent-hover: #aa3f33;
				--color-border: rgba(29, 28, 26, 0.12);
				--color-border-strong: rgba(29, 28, 26, 0.28);
				--color-surface: rgba(255, 255, 255, 0.5);
				--color-surface-hover: rgba(255, 255, 255, 0.82);
				--font-display: 'Instrument Serif', Georgia, serif;
				--font-body: 'DM Sans', system-ui, sans-serif;
			}

			html[data-theme="dark"] {
				--color-ink: #e8e6e3;
				--color-paper: #0a0a0b;
				--color-muted: #96928d;
				--color-accent: #e85d4c;
				--color-accent-hover: #f06b5a;
				--color-border: rgba(232, 230, 227, 0.12);
				--color-border-strong: rgba(232, 230, 227, 0.28);
				--color-surface: rgba(255, 255, 255, 0.025);
				--color-surface-hover: rgba(255, 255, 255, 0.055);
			}

			@media (prefers-color-scheme: dark) {
				:root:not([data-theme]) {
					--color-ink: #e8e6e3;
					--color-paper: #0a0a0b;
					--color-muted: #96928d;
					--color-accent: #e85d4c;
					--color-accent-hover: #f06b5a;
					--color-border: rgba(232, 230, 227, 0.12);
					--color-border-strong: rgba(232, 230, 227, 0.28);
					--color-surface: rgba(255, 255, 255, 0.025);
					--color-surface-hover: rgba(255, 255, 255, 0.055);
				}
			}

			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			html {
				scroll-behavior: smooth;
				background: var(--color-paper);
			}

			body {
				font-family: var(--font-body);
				background: var(--color-paper);
				color: var(--color-ink);
				line-height: 1.6;
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
				transition: background-color 180ms ease, color 180ms ease;
			}

			::selection {
				background: var(--color-accent);
				color: white;
			}

			@keyframes fadeUp {
				from {
					opacity: 0;
					transform: translateY(24px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			@keyframes fadeIn {
				from { opacity: 0; }
				to { opacity: 1; }
			}

			@keyframes scaleIn {
				from {
					opacity: 0;
					transform: scale(0.95);
				}
				to {
					opacity: 1;
					transform: scale(1);
				}
			}

			.animate-fade-up {
				animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
				opacity: 0;
			}

			.animate-fade-in {
				animation: fadeIn 0.6s ease-out forwards;
				opacity: 0;
			}

			.animate-scale-in {
				animation: scaleIn 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
				opacity: 0;
			}

			.delay-1 { animation-delay: 0.1s; }
			.delay-2 { animation-delay: 0.2s; }
			.delay-3 { animation-delay: 0.3s; }
			.delay-4 { animation-delay: 0.4s; }
			.delay-5 { animation-delay: 0.5s; }
			.delay-6 { animation-delay: 0.6s; }

			@media (prefers-reduced-motion: reduce) {
				html {
					scroll-behavior: auto;
				}

				body,
				.animate-fade-up,
				.animate-fade-in,
				.animate-scale-in {
					animation: none !important;
					opacity: 1;
					transition: none;
				}
			}
		</style>
	</head>
	<body>
		<slot />
		<HireFloat />
	</body>
</html>
