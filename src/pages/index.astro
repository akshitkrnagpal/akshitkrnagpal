---
import { Image } from "astro:assets";
import avatar from "../assets/avatar.jpg";
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { featured, more } from "../data/projects";

const bio =
  "Senior full-stack engineer, now building AI agents, evals, and developer tools.";
const projects = [...featured, ...more];
const filters = [
  { id: "all", label: "Everything" },
  { id: "tools", label: "AI & dev tools" },
  { id: "apps", label: "Apps" },
  { id: "web", label: "Web & commerce" },
];
const socials = [
  {
    label: "GitHub",
    href: "https://github.com/akshitkrnagpal",
    note: "The code lives here",
  },
  {
    label: "LinkedIn",
    href: "https://linkedin.com/in/akshitkrnagpal",
    note: "Say hello",
  },
  { label: "X", href: "https://x.com/akshit_io", note: "Find me here, too" },
];
---

<Layout>
  <a class="skip-link" href="#main">
    Skip to content
  </a>
  <header class="site-header">
    <nav class="shell navigation" aria-label="Site">
      <a class="wordmark" href="#top" aria-label="Akshit Kr Nagpal, home">
        <span class="monogram" aria-hidden="true">
          a.
        </span>
        <span>
          akshit<span class="domain">.io</span>
        </span>
      </a>
      <div class="nav-links">
        <a href="#projects">The projects</a>
        <a href="#connect">
          Say hello <span aria-hidden="true">↗</span>
        </a>
      </div>
    </nav>
  </header>

  <main id="main">
    <section id="top" class="shell hero" aria-labelledby="hero-title">
      <div class="hero-copy animate-fade-up">
        <p class="eyebrow">
          <span class="tiny-star" aria-hidden="true">
            ✳
          </span>{" "}
          A small software workshop
        </p>
        <h1 id="hero-title">
          Akshit Kr
          <br />
          Nagpal.
          <br />
          <em>
            Engineer by trade.
            <br />
            Builder by nature.
          </em>
        </h1>
        <p class="bio">{bio}</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#projects">
            Explore the projects <span aria-hidden="true">↓</span>
          </a>
          <a
            class="text-link"
            href="https://github.com/akshitkrnagpal"
            target="_blank"
            rel="noopener noreferrer"
          >
            Find me on GitHub <span aria-hidden="true">↗</span>
          </a>
        </div>
        <p class="hero-footnote">
          <span aria-hidden="true">↳</span> {projects.length} projects. Plenty
          of rabbit holes.
        </p>
      </div>

      <div
        class="desk animate-fade-up delay-2"
        aria-label="A few notes from my workbench"
      >
        <div class="desk-grid" aria-hidden="true"></div>
        <svg
          class="doodle orbit"
          viewBox="0 0 110 100"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M49 9C97-9 129 65 82 85S-2 74 10 43s79-34 89 2-67 63-76 28"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          />
          <path
            d="m36 7 15 2-4 14"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        <figure class="portrait-note">
          <span class="tape" aria-hidden="true"></span>
          <Image
            src={avatar}
            alt="Akshit Kr Nagpal"
            widths={[256, 512]}
            sizes="(min-width: 64rem) 230px, 202px"
            loading="eager"
            fetchpriority="high"
          />
          <figcaption>
            Hey! <span aria-hidden="true">☺</span>
          </figcaption>
        </figure>
        <div class="build-note">
          <p class="note-label">
            <span aria-hidden="true">&gt;_</span> Currently exploring
          </p>
          <p>
            Agents.
            <br />
            Evals.
            <br />
            Better dev tools.
          </p>
          <span class="note-bottom">An idea → a working thing</span>
        </div>
        <div class="curiosity-sticker" aria-hidden="true">
          <svg viewBox="0 0 40 40" fill="none">
            <path
              d="M20 2v36M2 20h36M7.3 7.3l25.4 25.4M7.3 32.7 32.7 7.3"
              stroke="currentColor"
              stroke-width="3"
            />
          </svg>
          <span>
            Made with
            <br />
            curiosity
          </span>
        </div>
        <span class="desk-caption" aria-hidden="true">
          a little bit of everything
        </span>
        <svg
          class="doodle desk-arrow"
          viewBox="0 0 100 65"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M4 6c32 0 4 42 52 40 13-1 27-4 35-13m-2-9 6 8-3 13"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </div>
    </section>

    <div class="interlude" aria-hidden="true">
      <div class="shell interlude-inner">
        <span>Less talking. More making.</span>
        <span class="interlude-star">✳</span>
        <span>Small tools. Big rabbit holes.</span>
        <span class="interlude-star">✳</span>
        <span>Built to be used.</span>
      </div>
    </div>

    <section
      id="projects"
      class="shell projects-section"
      aria-labelledby="projects-title"
    >
      <div class="section-heading">
        <div>
          <p class="eyebrow">01 / The workbench</p>
          <h2 id="projects-title">
            Things I've <em>put into the world.</em>
          </h2>
        </div>
        <p class="section-note">
          Some solve a tiny annoyance.
          <br />
          Some took on a life of their own.
        </p>
      </div>
      <div class="project-controls" data-project-controls hidden>
        <div class="filters" role="group" aria-label="Filter projects">
          {filters.map((filter) => (
            <button
              type="button"
              data-filter={filter.id}
              aria-pressed={filter.id === "all"}
            >
              {filter.label}
              <span>
                {filter.id === "all"
                  ? projects.length
                  : projects.filter((project) => project.category === filter.id)
                      .length}
              </span>
            </button>
          ))}
        </div>
        <button class="surprise-button" type="button" data-surprise>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect
              x="4"
              y="4"
              width="16"
              height="16"
              rx="4"
              stroke="currentColor"
              stroke-width="1.5"
            />
            <circle cx="8" cy="8" r="1.2" fill="currentColor" />
            <circle cx="16" cy="8" r="1.2" fill="currentColor" />
            <circle cx="12" cy="12" r="1.2" fill="currentColor" />
            <circle cx="8" cy="16" r="1.2" fill="currentColor" />
            <circle cx="16" cy="16" r="1.2" fill="currentColor" />
          </svg>
          Pick one for me
        </button>
      </div>
      <p
        class="filter-status"
        data-filter-status
        role="status"
        aria-live="polite"
        aria-atomic="true"
        hidden
      >
        Showing all {projects.length} projects
      </p>
      <div class="project-grid" data-featured-group>
        {featured.map((project, index) => (
          <ProjectCard project={project} index={index} />
        ))}
      </div>

      <div class="more-projects" data-more-group>
        <div class="more-heading">
          <h3 id="more-title">The side quests</h3>
          <span>Smaller apps. Equally good rabbit holes.</span>
        </div>
        <ul class="project-list" aria-labelledby="more-title">
          {more.map((project, index) => (
            <li
              class="project-row"
              data-project
              data-project-name={project.name}
              data-category={project.category}
            >
              <span class="row-number" aria-hidden="true">
                {String(index + featured.length + 1).padStart(2, "0")}
              </span>
              <div class="row-info">
                <h4>
                  <a
                    href={project.links[0].href}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-project-link
                  >
                    {project.name}
                  </a>
                  <span class="row-tag">{project.tag}</span>
                </h4>
                <p>{project.description}</p>
              </div>
              <div class="row-links">
                {project.links.map((link) => (
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${project.name}: ${link.label}`}
                  >
                    {link.label}
                    <span aria-hidden="true"> ↗</span>
                  </a>
                ))}
              </div>
            </li>
          ))}
        </ul>
      </div>
      <p class="github-note">
        There's always another experiment.{" "}
        <a
          href="https://github.com/akshitkrnagpal"
          target="_blank"
          rel="noopener noreferrer"
        >
          See what I'm building on GitHub <span aria-hidden="true">↗</span>
        </a>
      </p>
    </section>

    <section
      id="connect"
      class="shell connect-section"
      aria-labelledby="connect-title"
    >
      <div class="connect-copy">
        <p class="eyebrow">02 / The human part</p>
        <h2 id="connect-title">
          Good things start
          <br />
          with <em>a hello.</em>
          <svg viewBox="0 0 100 90" fill="none" aria-hidden="true">
            <path
              d="M46 8C22-2 4 15 10 34c5 13 34 34 37 39 5-4 37-25 41-41C96 4 64-2 46 8Z"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
            />
          </svg>
        </h2>
        <p>
          Working on something interesting? Have a question about a project? I'd
          love to hear about it.
        </p>
      </div>
      <div class="contact-links">
        {socials.map((social) => (
          <a href={social.href} target="_blank" rel="noopener noreferrer">
            <div>
              <span>{social.label}</span>
              <small>{social.note}</small>
            </div>
            <span class="contact-arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        ))}
      </div>
    </section>
  </main>

  <footer class="shell footer">
    <p>© {new Date().getFullYear()} Akshit Kr Nagpal</p>
    <p>
      Always a work in progress <span aria-hidden="true">✳</span>
    </p>
    <a href="#top">
      Back to top <span aria-hidden="true">↑</span>
    </a>
  </footer>
</Layout>

<script>
  const controls = document.querySelector<HTMLElement>(
    "[data-project-controls]",
  );
  const status = document.querySelector<HTMLElement>("[data-filter-status]");
  const projects = [
    ...document.querySelectorAll<HTMLElement>("[data-project]"),
  ];
  const filters = [
    ...document.querySelectorAll<HTMLButtonElement>("[data-filter]"),
  ];

  if (controls && status && projects.length) {
    controls.hidden = false;
    status.hidden = false;
    filters.forEach((button) =>
      button.addEventListener("click", () => {
        const category = button.dataset.filter;
        filters.forEach((filter) =>
          filter.setAttribute("aria-pressed", String(filter === button)),
        );
        projects.forEach((project) => {
          project.hidden =
            category !== "all" && project.dataset.category !== category;
          project.classList.remove("is-picked");
        });
        document
          .querySelectorAll<HTMLElement>(
            "[data-featured-group], [data-more-group]",
          )
          .forEach((group) => {
            group.hidden = !group.querySelector("[data-project]:not([hidden])");
          });
        const visible = projects.filter((project) => !project.hidden).length;
        status.textContent =
          category === "all"
            ? `Showing all ${visible} projects`
            : `Showing ${visible} projects in ${button.firstChild?.textContent?.trim()}`;
      }),
    );

    document
      .querySelector<HTMLButtonElement>("[data-surprise]")
      ?.addEventListener("click", () => {
        const visible = projects.filter((project) => !project.hidden);
        const unpicked = visible.filter(
          (project) => !project.classList.contains("is-picked"),
        );
        const choices = unpicked.length ? unpicked : visible;
        const project = choices[Math.floor(Math.random() * choices.length)];
        const link = project?.querySelector<HTMLAnchorElement>(
          "[data-project-link]",
        );
        if (!project || !link) return;
        projects.forEach((item) => item.classList.remove("is-picked"));
        project.classList.add("is-picked");
        link.focus({ preventScroll: true });
        project.scrollIntoView({
          behavior: window.matchMedia("(prefers-reduced-motion: reduce)")
            .matches
            ? "instant"
            : "smooth",
          block: "center",
        });
        status.textContent = `How about ${project.dataset.projectName}?`;
      });
  }
</script>

<style>
  .shell {
    width: min(1184px, calc(100% - 96px));
    margin-inline: auto;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  a:focus,
  button:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 5px;
  }
  [hidden] {
    display: none !important;
  }
  .skip-link {
    position: fixed;
    top: 8px;
    left: 8px;
    z-index: 100;
    padding: 12px 20px;
    background: var(--color-ink);
    color: var(--color-paper);
    transform: translateY(-150%);
  }
  .skip-link:focus {
    transform: none;
  }
  .site-header {
    border-bottom: 1px solid var(--color-border);
  }
  .navigation {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 88px;
    padding-right: 52px;
  }
  .wordmark {
    min-height: 44px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 700;
    font-size: 20px;
    letter-spacing: -0.7px;
  }
  .monogram {
    display: grid;
    place-items: center;
    width: 37px;
    height: 37px;
    background: var(--color-ink);
    color: var(--color-paper);
    border-radius: 10px;
    font-family: var(--font-display);
    font-size: 33px;
    font-style: italic;
    font-weight: 400;
    line-height: 1;
    padding-bottom: 7px;
  }
  .domain {
    color: var(--color-muted);
    font-weight: 400;
  }
  .nav-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .nav-links {
    display: flex;
    gap: 32px;
    font-size: 13px;
    font-weight: 500;
  }
  .nav-links a:hover,
  .text-link:hover {
    color: var(--color-accent);
  }
  .hero {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    align-items: center;
    gap: 40px;
    padding-block: 76px 80px;
  }
  .eyebrow {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.065em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .tiny-star {
    color: var(--color-accent);
    font-size: 21px;
    line-height: 1;
  }
  h1 {
    font-size: clamp(52px, 5.8vw, 78px);
    font-weight: 500;
    line-height: 0.99;
    letter-spacing: -0.045em;
    margin-block: 27px 28px;
  }
  h1 em,
  h2 em {
    font-family: var(--font-display);
    font-weight: 400;
    color: var(--color-accent);
    letter-spacing: -0.035em;
  }
  h1 em {
    line-height: 1.05;
  }
  .bio {
    max-width: 415px;
    font-size: 15px;
    color: var(--color-muted);
    line-height: 1.8;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 28px;
  }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    min-height: 48px;
    padding: 12px 20px;
    font-size: 13px;
    font-weight: 500;
    border-radius: 8px;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }
  .button-primary {
    background: var(--color-accent);
    color: var(--color-paper);
    box-shadow: 3px 3px 0 var(--color-ink);
  }
  .button:hover {
    transform: translate(-1px, -1px);
    box-shadow: 5px 5px 0 var(--color-ink);
  }
  .text-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 12px;
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .hero-footnote {
    margin-top: 23px;
    font-size: 11px;
    color: var(--color-muted);
  }
  .hero-footnote span {
    display: inline-block;
    margin-right: 7px;
    color: var(--color-accent);
  }
  .desk {
    position: relative;
    height: 500px;
    isolation: isolate;
  }
  .desk-grid {
    position: absolute;
    inset: 22px -5px 38px 0;
    z-index: -1;
    background-image: radial-gradient(
      var(--color-border-strong) 0.7px,
      transparent 0.7px
    );
    background-size: 18px 18px;
    mask-image: radial-gradient(ellipse, #000 20%, transparent 72%);
  }
  .portrait-note {
    position: absolute;
    top: 36px;
    left: 44px;
    width: 254px;
    padding: 12px 12px 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: 0 10px 22px rgb(0 0 0 / 0.08);
    transform: rotate(-7deg);
    z-index: 2;
  }
  .portrait-note img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    filter: saturate(0.8);
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    padding: 15px 8px;
    font-family: var(--font-display);
    font-size: 22px;
    font-style: italic;
  }
  figcaption span {
    font-style: normal;
    font-family: var(--font-body);
    font-size: 24px;
    color: var(--color-accent);
  }
  .tape {
    position: absolute;
    top: -15px;
    left: 87px;
    width: 76px;
    height: 30px;
    background: var(--color-yellow);
    opacity: 0.65;
    transform: rotate(4deg);
  }
  .build-note {
    position: absolute;
    bottom: 36px;
    right: 0;
    width: 278px;
    border: 1px solid var(--color-border-strong);
    border-radius: 10px;
    background: var(--color-blue-soft);
    padding: 22px 25px;
    box-shadow: 5px 5px 0 var(--color-border);
    transform: rotate(5deg);
    z-index: 3;
  }
  .note-label {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 10px;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }
  .note-label span {
    font-size: 15px;
  }
  .build-note > p:nth-child(2) {
    font-size: 25px;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.04em;
    padding-block: 19px;
  }
  .note-bottom {
    display: block;
    border-top: 1px solid var(--color-border-strong);
    padding-top: 12px;
    font-family: ui-monospace, monospace;
    font-size: 10px;
    color: var(--color-muted);
  }
  .curiosity-sticker {
    position: absolute;
    right: 0;
    top: 45px;
    width: 115px;
    height: 115px;
    background: var(--color-yellow);
    color: var(--color-sticker-ink);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 5px;
    transform: rotate(12deg);
    z-index: 4;
    box-shadow: 3px 3px 0 var(--color-sticker-ink);
  }
  .curiosity-sticker svg {
    width: 28px;
    height: 28px;
  }
  .curiosity-sticker span {
    text-align: center;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.2;
  }
  .doodle {
    position: absolute;
    color: var(--color-accent);
  }
  .orbit {
    width: 77px;
    height: 70px;
    right: 10px;
    top: -20px;
    transform: rotate(10deg);
  }
  .desk-caption {
    position: absolute;
    bottom: 17px;
    left: -6px;
    font-size: 21px;
    font-family: var(--font-display);
    font-style: italic;
    transform: rotate(-6deg);
  }
  .desk-arrow {
    width: 80px;
    bottom: 55px;
    left: 8px;
    transform: rotate(-18deg);
  }
  .interlude {
    background: var(--color-green);
    border-block: 1px solid var(--color-border);
  }
  .interlude-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding-block: 19px;
    font-size: 12px;
    font-weight: 500;
  }
  .interlude-star {
    font-size: 21px;
    color: var(--color-muted);
  }
  .projects-section {
    padding-block: 84px 72px;
    scroll-margin-top: 30px;
  }
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
  }
  h2 {
    font-size: clamp(36px, 3.7vw, 49px);
    line-height: 1.12;
    font-weight: 500;
    letter-spacing: -0.045em;
    margin-top: 17px;
  }
  .section-heading h2 em {
    display: block;
  }
  .section-note {
    font-size: 12px;
    line-height: 1.8;
    color: var(--color-muted);
    padding-bottom: 5px;
  }
  .project-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 15px;
    margin-top: 35px;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .filters button,
  .surprise-button {
    cursor: pointer;
    font: inherit;
    font-size: 11px;
    min-height: 44px;
    border: 1px solid var(--color-border);
    background: transparent;
    border-radius: 7px;
    padding: 9px 13px;
    color: var(--color-muted);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition:
      background 180ms ease,
      color 180ms ease;
  }
  .filters button span {
    font-size: 9px;
    opacity: 1;
  }
  .filters button[aria-pressed="true"] {
    background: var(--color-ink);
    color: var(--color-paper);
    border-color: var(--color-ink);
  }
