---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { featured, more } from "../data/projects";

const bio = "Senior full-stack engineer, now building AI agents, evals, and developer tools.";

// Paths from simple-icons.
const socials = [
  {
    label: "GitHub",
    href: "https://github.com/akshitkrnagpal",
    path: "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12",
  },
  {
    label: "LinkedIn",
    href: "https://linkedin.com/in/akshitkrnagpal",
    path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
  },
  {
    label: "X",
    href: "https://x.com/akshit_io",
    path: "M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z",
  },
];

// The hero intro, one line per entry: each piece of text is followed by a link chip.
const intro = [
  [["Browse my code at", "GitHub"]],
  [["DM me at", "LinkedIn"], [" or", "X"]],
];

const pops = ["pink", "yellow", "mint", "blue", "orange", "lilac"];

// Draggable stickers scattered under the hero. Tilt is in degrees.
const stickers = [
  { text: "full-stack since forever", pop: "yellow", tilt: -6 },
  { text: "🤖 agent wrangler", pop: "mint", tilt: 4 },
  { text: "evals > vibes", pop: "pink", tilt: -3 },
  { text: "TypeScript ♥", pop: "blue", tilt: 7 },
  { text: "MCP nerd", pop: "lilac", tilt: -5 },
  { text: "☕ → code", pop: "orange", tilt: 3 },
];

const marquee = ["AI agents", "Evals", "Developer tools", "iOS apps", "Open source", "CLIs", "MCP servers", "Side quests"];
const name = "Akshit Kr Nagpal";
---

<Layout>
  <nav class="navbar px-6 md:px-12" aria-label="Site">
    <div class="max-w-6xl mx-auto w-full flex">
      <a href="#top" class="navbar-profile">
        <img src="https://avatars.githubusercontent.com/u/15872348" alt="" width="36" height="36" />
        <span class="navbar-text">
          Akshit Kr Nagpal
          <span class="navbar-bio">{bio}</span>
        </span>
      </a>
    </div>
    <div class="navbar-socials">
      {socials.map((s) => (
        <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg>
        </a>
      ))}
    </div>
  </nav>

  <main id="top" class="overflow-x-clip pt-20 md:pt-24 pb-16">
    <section class="hero px-6 md:px-12 max-w-4xl mx-auto text-center">
      <div class="hero-avatar animate-scale-in">
        <button type="button" class="avatar-button" data-confetti aria-label="Throw confetti">
          <svg class="avatar-ring" viewBox="0 0 200 200" aria-hidden="true">
            <defs>
              <path id="ring-path" d="M100,100 m-84,0 a84,84 0 1,1 168,0 a84,84 0 1,1 -168,0" />
            </defs>
            <text>
              <textPath href="#ring-path" textLength="520" lengthAdjust="spacing">agents ✦ evals ✦ dev tools ✦ open source ✦ click me ✦ </textPath>
            </text>
          </svg>
          <img
            src="https://avatars.githubusercontent.com/u/15872348"
            alt="Akshit Kr Nagpal"
            width="128"
            height="128"
          />
        </button>
      </div>

      <p class="kicker animate-fade-up delay-1">
        <span class="wave" aria-hidden="true">👋</span> Hey there, I'm
      </p>
      <h1 data-hero-name class="hero-name animate-fade-up delay-1" aria-label={name}>
        {name.split(" ").map((word, w, words) => {
          const offset = words.slice(0, w).join("").length;
          return <><span class="word" aria-hidden="true">{[...word].map((char, i) => (
            <span class="letter" style={`--pop: var(--pop-${pops[(offset + i) % pops.length]})`}>{char}</span>
          ))}</span>{w < words.length - 1 && " "}</>;
        })}
      </h1>
      <p class="hero-bio animate-fade-up delay-2">
        Senior full-stack engineer, now building
        <mark style="--pop: var(--pop-pink); --tilt: -1.5deg">AI agents</mark>,
        <mark style="--pop: var(--pop-yellow); --tilt: 1deg">evals</mark>, and
        <mark style="--pop: var(--pop-mint); --tilt: -1deg">developer tools</mark>.
      </p>

      <ul class="stickers animate-fade-up delay-3" aria-label="A few things about me">
        {stickers.map((s) => (
          <li class="sticker" data-sticker style={`--pop: var(--pop-${s.pop}); --tilt: ${s.tilt}deg`}>{s.text}</li>
        ))}
      </ul>
      <p class="hint animate-fade-in delay-4" aria-hidden="true">↑ psst, those stickers are draggable</p>

      <p class="intro animate-fade-up delay-4">
        {intro.map((line) => (
          <span class="block">
            {line.map(([text, label]) => {
              const s = socials.find((s) => s.label === label)!;
              return <>{text}{" "}<a href={s.href} target="_blank" rel="noopener noreferrer" class="intro-chip"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg>{s.label}</a></>;
            })}
          </span>
        ))}
      </p>
    </section>

    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        {[0, 1].map(() => (
          <span class="marquee-group">
            {marquee.map((item) => <span>{item}<span class="marquee-star">✦</span></span>)}
          </span>
        ))}
      </div>
    </div>

    <section id="projects" class="px-6 md:px-12 max-w-6xl mx-auto scroll-mt-24" aria-labelledby="projects-title">
      <h2 id="projects-title" class="section-title">
        Stuff I've <span class="squiggle">shipped</span>
      </h2>
      <p class="section-sub">Real products, real users, real bugs (now fixed, mostly).</p>
      <div class="grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3 mt-12">
        {featured.map((project, i) => <ProjectCard project={project} index={i} pop={pops[i % pops.length]} />)}
      </div>

      <h2 id="more-title" class="section-title section-title--small mt-28">
        More apps &amp; tools
      </h2>
      <p class="section-sub">Smaller experiments, utilities, and things I needed one weekend.</p>
      <ul class="tiles mt-10" aria-labelledby="more-title">
        {more.map((project, i) => (
          <li class="tile" style={`--pop: var(--pop-${pops[(i + 2) % pops.length]})`}>
            <div class="tile-head">
              <a href={project.links[0].href} target="_blank" rel="noopener noreferrer" class="tile-name">{project.name}</a>
              <span class="tile-tag">{project.tag}</span>
            </div>
            <p>{project.description}</p>
            <div class="tile-links">
              {project.links.map((link) => (
                <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={`${project.name}: ${link.label}`}>
                  {link.label}<span aria-hidden="true"> ↗</span>
                </a>
              ))}
            </div>
          </li>
        ))}
      </ul>
    </section>

    <footer class="px-6 md:px-12 max-w-3xl mx-auto mt-32 text-center">
      <p class="footer-title">Say hi <span class="wave" aria-hidden="true">👋</span></p>
      <p class="section-sub">I'm always up for talking agents, evals, or your weird side project.</p>
      <div class="footer-links">
        {socials.map((s, i) => (
          <a href={s.href} target="_blank" rel="noopener noreferrer" class="footer-chip" style={`--pop: var(--pop-${pops[(i * 2 + 1) % pops.length]})`}>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg>{s.label}
          </a>
        ))}
      </div>
      <p class="mt-12 text-sm text-[var(--color-muted)]">
        Everything else lives on <a href="https://github.com/akshitkrnagpal" target="_blank" rel="noopener noreferrer" class="text-[var(--color-ink)] underline underline-offset-4">GitHub</a>.
      </p>
    </footer>
  </main>
</Layout>

<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  // Show the navbar profile once the hero name scrolls under it.
  const name = document.querySelector("[data-hero-name]");
  if (name) {
    new IntersectionObserver(([entry]) => {
      const scrolled = !entry.isIntersecting && entry.boundingClientRect.top < 0;
      document.documentElement.toggleAttribute("data-scrolled", scrolled);
    }, { rootMargin: "-76px 0px 0px 0px" }).observe(name);
  }

  // Clicking the avatar throws confetti from its center.
  const confettiColors = ["--pop-pink", "--pop-yellow", "--pop-mint", "--pop-blue", "--pop-orange", "--pop-lilac"]
    .map((token) => getComputedStyle(document.documentElement).getPropertyValue(token).trim());

  function throwConfetti(x: number, y: number) {
    if (reducedMotion.matches) return;
    for (let i = 0; i < 60; i++) {
      const piece = document.createElement("span");
      piece.className = "confetti";
      piece.style.left = `${x}px`;
      piece.style.top = `${y}px`;
      piece.style.background = confettiColors[i % confettiColors.length];
      if (i % 3 === 0) piece.style.borderRadius = "999px";
      document.body.append(piece);

      const angle = Math.random() * Math.PI * 2;
      const distance = 120 + Math.random() * 220;
      const dx = Math.cos(angle) * distance;
      const dy = Math.sin(angle) * distance - 120;
      const spin = (Math.random() - 0.5) * 1080;
      piece.animate(
        [
          { transform: "translate(-50%, -50%) rotate(0deg)", opacity: 1 },
          { transform: `translate(calc(-50% + ${dx}px), calc(-50% + ${dy}px)) rotate(${spin / 2}deg)`, opacity: 1, offset: 0.55 },
          { transform: `translate(calc(-50% + ${dx * 1.15}px), calc(-50% + ${dy + 260}px)) rotate(${spin}deg)`, opacity: 0 },
        ],
        { duration: 1300 + Math.random() * 700, easing: "cubic-bezier(0.2, 0.8, 0.3, 1)" },
      ).finished.then(() => piece.remove());
    }
  }

  document.querySelectorAll<HTMLButtonElement>("[data-confetti]").forEach((button) => {
    button.addEventListener("click", () => {
      const { left, top, width, height } = button.getBoundingClientRect();
      throwConfetti(left + width / 2, top + height / 2);
      button.classList.remove("is-boing");
      void button.offsetWidth;
      button.classList.add("is-boing");
    });
  });

  // Stickers can be dragged anywhere, and remember where they were dropped.
  let topLayer = 1;
  document.querySelectorAll<HTMLElement>("[data-sticker]").forEach((sticker) => {
    let startX = 0;
    let startY = 0;
    let x = 0;
    let y = 0;

    sticker.addEventListener("pointerdown", (event) => {
      if (event.button !== 0) return;
      sticker.setPointerCapture(event.pointerId);
      startX = event.clientX - x;
      startY = event.clientY - y;
      sticker.classList.add("is-dragging");
      sticker.style.zIndex = String(++topLayer);
    });

    sticker.addEventListener("pointermove", (event) => {
      if (!sticker.hasPointerCapture(event.pointerId)) return;
      x = event.clientX - startX;
      y = event.clientY - startY;
      sticker.style.translate = `${x}px ${y}px`;
    });

    const drop = () => sticker.classList.remove("is-dragging");
    sticker.addEventListener("pointerup", drop);
    sticker.addEventListener("pointercancel", drop);
  });
</script>

<style>
  .navbar {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    display: flex;
    align-items: center;
    height: 4.75rem;
    border-bottom: 2px solid transparent;
    pointer-events: none;
    transition: background-color 250ms ease, border-color 250ms ease;
  }

  .navbar-profile {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: inherit;
    text-decoration: none;
  }

  /* Pinned just left of the floating theme toggle (2.75rem wide). */
  .navbar-socials {
    position: absolute;
    right: calc(max(1.5rem, env(safe-area-inset-right)) + 3.75rem);
    display: flex;
    gap: 1rem;
  }

  .navbar-socials a {
    display: grid;
    color: var(--color-muted);
    transition: color 200ms ease, transform 200ms ease;
  }

  .navbar-socials a:hover { color: var(--color-ink); transform: rotate(-12deg) scale(1.15); }
  .navbar-socials svg { width: 1.125rem; height: 1.125rem; }

  .navbar-profile,
  .navbar-socials {
    opacity: 0;
    transform: translateY(0.75rem);
    transition: opacity 300ms ease, transform 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .navbar-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.3;
  }

  .navbar-bio {
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--color-muted);
  }

  /* No room beside the socials on phones. */
  @media (max-width: 47.99rem) {
    .navbar-bio { display: none; }
  }

  .navbar-profile img {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    border: 2px solid var(--color-ink);
    background: var(--pop-yellow);
    object-fit: cover;
  }

  :global(html[data-scrolled]) .navbar {
    pointer-events: auto;
    background: color-mix(in srgb, var(--color-paper) 88%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-color: var(--color-ink);
  }

  :global(html[data-scrolled]) .navbar-profile,
  :global(html[data-scrolled]) .navbar-socials {
    opacity: 1;
    transform: none;
  }

  /* Hero */

  .hero-avatar {
    display: grid;
    place-items: center;
    margin-bottom: 1.25rem;
  }

  .avatar-button {
    position: relative;
    display: grid;
    place-items: center;
    width: 12.5rem;
    height: 12.5rem;
    border: 0;
    background: none;
    color: var(--color-ink);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .avatar-button img {
    grid-area: 1 / 1;
    width: 8.5rem;
    height: 8.5rem;
    border-radius: 999px;
    border: 3px solid var(--color-ink);
    background: var(--pop-yellow);
    box-shadow: 5px 5px 0 var(--color-ink);
    object-fit: cover;
    transition: transform 300ms cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 300ms ease;
  }

  .avatar-button:hover img { transform: rotate(-6deg) scale(1.04); box-shadow: 8px 8px 0 var(--color-ink); }
  .avatar-button:focus-visible { outline: none; }
  .avatar-button:focus-visible img { outline: 3px solid var(--pop-blue); outline-offset: 4px; }
  .avatar-button.is-boing img { animation: boing 600ms cubic-bezier(0.34, 1.56, 0.64, 1); }

  @keyframes boing {
    0% { transform: scale(1); }
    30% { transform: scale(0.85, 1.12); }
    55% { transform: scale(1.12, 0.9); }
    75% { transform: scale(0.96, 1.04); }
    100% { transform: scale(1); }
  }

  .avatar-ring {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    overflow: visible;
    animation: spin 22s linear infinite;
  }

  .avatar-ring text {
    fill: currentColor;
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .avatar-button:hover .avatar-ring { animation-duration: 6s; }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .kicker {
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--color-muted);
  }

  .wave {
    display: inline-block;
    transform-origin: 70% 70%;
    animation: wave 2.4s ease-in-out infinite;
  }

  @keyframes wave {
    0%, 60%, 100% { transform: rotate(0deg); }
    10%, 30% { transform: rotate(16deg); }
    20% { transform: rotate(-8deg); }
    40% { transform: rotate(-4deg); }
    50% { transform: rotate(10deg); }
  }

  .hero-name {
    margin: 0.25rem 0 1.25rem;
    font-family: var(--font-display);
    font-size: clamp(3rem, 11vw, 5.75rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.035em;
  }

  .word {
    display: inline-block;
    white-space: nowrap;
  }

  .letter {
    display: inline-block;
    transition: transform 250ms cubic-bezier(0.34, 1.56, 0.64, 1), color 150ms ease;
  }

  .letter:hover {
    color: var(--pop);
    transform: translateY(-0.12em) rotate(-8deg) scale(1.12);
    -webkit-text-stroke: 2px var(--color-ink);
  }

  .hero-bio {
    max-width: 34rem;
    margin-inline: auto;
    font-size: clamp(1.125rem, 2.4vw, 1.375rem);
    line-height: 1.7;
    color: var(--color-muted);
  }

  .hero-bio mark {
    display: inline-block;
    padding: 0 0.4rem;
    border-radius: 0.375rem;
    background: var(--pop);
    color: var(--color-on-pop);
    font-weight: 600;
    line-height: 1.5;
    transform: rotate(var(--tilt));
    transition: transform 250ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .hero-bio mark:hover { transform: rotate(calc(var(--tilt) * -2)) scale(1.06); }

  .stickers {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.875rem 0.75rem;
    margin: 2.5rem auto 0;
    max-width: 38rem;
    list-style: none;
  }

  .sticker {
    position: relative;
    padding: 0.4rem 0.9rem;
    border: 2px solid var(--color-ink);
    border-radius: 999px;
    background: var(--pop);
    color: var(--color-on-pop);
    box-shadow: 3px 3px 0 var(--color-ink);
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    transform: rotate(var(--tilt));
    cursor: grab;
    user-select: none;
    touch-action: none;
    transition: transform 200ms cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 200ms ease;
  }

  .sticker:hover { transform: rotate(calc(var(--tilt) * -1)) scale(1.06); }

  .sticker.is-dragging {
    cursor: grabbing;
    transform: rotate(0deg) scale(1.12);
    box-shadow: 8px 10px 0 var(--color-ink);
  }

  .hint {
    margin-top: 1rem;
    font-size: 0.8125rem;
    color: var(--color-muted);
    font-style: italic;
  }

  @media (hover: none) {
    .hint { display: none; }
  }

  .intro {
    max-width: 36rem;
    margin: 2rem auto 0;
    line-height: 2.6;
    color: var(--color-muted);
  }

  .intro-chip,
  .footer-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    vertical-align: middle;
    line-height: 1.5;
    padding: 0.2rem 0.75rem;
    border-radius: 999px;
    border: 2px solid var(--color-ink);
    background: var(--color-card);
    box-shadow: 3px 3px 0 var(--color-ink);
    color: var(--color-ink);
    font-weight: 600;
    text-decoration: none;
    transition: background-color 150ms ease, color 150ms ease, transform 150ms ease, box-shadow 150ms ease;
  }

  .intro-chip svg { width: 0.875rem; height: 0.875rem; }

  .intro-chip:hover,
  .footer-chip:hover {
    background: var(--color-ink);
    color: var(--color-paper);
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 var(--color-ink);
  }

  .intro-chip:active,
  .footer-chip:active {
    transform: translate(3px, 3px);
    box-shadow: 0 0 0 var(--color-ink);
  }

  /* Shrink the hero avatar up toward the navbar as it scrolls away. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero-avatar {
        animation: avatar-exit linear both;
        animation-timeline: view();
        animation-range: exit-crossing 20% exit-crossing 100%;
      }
    }
  }

  @keyframes avatar-exit {
    to { opacity: 0; transform: translateY(35%) scale(0.4); }
  }

  /* Marquee */

  .marquee {
    margin: 6rem -2rem 6rem;
    padding: 0.875rem 0;
    border-block: 3px solid var(--color-ink);
    background: var(--pop-yellow);
    color: var(--color-on-pop);
    transform: rotate(-2deg);
    overflow: hidden;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 32s linear infinite;
  }

  .marquee:hover .marquee-track { animation-play-state: paused; }

  .marquee-group {
    display: flex;
    flex: none;
  }

  .marquee-group > span {
