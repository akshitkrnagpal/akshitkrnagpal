---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
import Stats from "../components/Stats.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Terminal from "../components/Terminal.astro";
import Footer from "../components/Footer.astro";
import { featured } from "../data/projects";
---

<Layout>
  <Nav />

  <main id="top">
    <Hero />
    <Marquee />
    <Stats />

    <section id="projects" class="section scroll-mt-24" aria-labelledby="projects-title">
      <header class="section-header" data-reveal>
        <p class="section-kicker">the main characters</p>
        <h2 id="projects-title" class="section-title">
          Stuff I've <span class="squiggle">shipped<svg viewBox="0 0 200 14" preserveAspectRatio="none" aria-hidden="true"><path d="M2 9C20 2 30 13 48 7s28-6 46 0 28 6 46 0 30-6 58 1" /></svg></span>
        </h2>
        <p class="section-lede">Products I designed, built, and launched end to end. Poke around, they're all live.</p>
      </header>
      <div class="grid">
        {featured.map((project, i) => <ProjectCard project={project} index={i} />)}
      </div>
    </section>

    <section id="junk-drawer" class="section scroll-mt-24" aria-labelledby="drawer-title">
      <header class="section-header" data-reveal>
        <p class="section-kicker">the supporting cast</p>
        <h2 id="drawer-title" class="section-title">The junk drawer</h2>
        <p class="section-lede">
          Smaller apps, CLIs, and experiments. It's a real terminal, so go ahead and type something.
          Everything else lives on <a href="https://github.com/akshitkrnagpal" target="_blank" rel="noopener noreferrer">GitHub</a>.
        </p>
      </header>
      <Terminal />
    </section>
  </main>

  <Footer />
</Layout>

<script>
  import { party } from "../scripts/confetti";

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  // Reveal sections as they scroll into view.
  const revealer = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (!entry.isIntersecting) continue;
      entry.target.classList.add("is-visible");
      revealer.unobserve(entry.target);
    }
  }, { rootMargin: "0px 0px -10% 0px" });
  document.querySelectorAll("[data-reveal]").forEach((el) => revealer.observe(el));

  // Tilt project cards toward the pointer.
  if (!reducedMotion.matches && window.matchMedia("(hover: hover)").matches) {
    document.querySelectorAll<HTMLElement>("[data-tilt]").forEach((card) => {
      const inner = card.firstElementChild as HTMLElement;
      card.addEventListener("pointermove", (event) => {
        const { left, top, width, height } = card.getBoundingClientRect();
        const x = (event.clientX - left) / width - 0.5;
        const y = (event.clientY - top) / height - 0.5;
        card.classList.add("is-tilting");
        inner.style.setProperty("--rx", `${(-y * 8).toFixed(2)}deg`);
        inner.style.setProperty("--ry", `${(x * 10).toFixed(2)}deg`);
      });
      card.addEventListener("pointerleave", () => {
        card.classList.remove("is-tilting");
        inner.style.setProperty("--rx", "0deg");
        inner.style.setProperty("--ry", "0deg");
      });
    });
  }

  // Party mode: the Konami code, or the hint in the footer for people without arrow keys.
  function partyMode() {
    party(["🎉", "🕹️", "✨", "🚀"]);
    if (reducedMotion.matches) return;
    document.documentElement.classList.add("party");
    window.setTimeout(() => document.documentElement.classList.remove("party"), 4000);
  }

  const code = ["arrowup", "arrowup", "arrowdown", "arrowdown", "arrowleft", "arrowright", "arrowleft", "arrowright", "b", "a"];
  let progress = 0;
  window.addEventListener("keydown", (event) => {
    if ((event.target as HTMLElement).closest("input, textarea")) return;
    const key = event.key.toLowerCase();
    progress = key === code[progress] ? progress + 1 : key === code[0] ? 1 : 0;
    if (progress === code.length) {
      progress = 0;
      partyMode();
    }
  });
  document.querySelector("[data-konami-hint]")?.addEventListener("click", partyMode);
</script>

<style>
  .section {
    max-width: 76rem;
    margin: 0 auto;
    padding: 6rem 1.5rem 0;
  }

  .section + .section { padding-top: 7rem; }
  .section:last-of-type { padding-bottom: 7rem; }

  @media (min-width: 64rem) {
    .section { padding-inline: 3rem; }
  }

  .section-header {
    max-width: 40rem;
    margin-bottom: 3rem;
  }

  .section-kicker {
    font-family: var(--font-hand);
    font-size: 1.625rem;
    font-weight: 600;
    line-height: 1;
    color: var(--color-muted);
    rotate: -2deg;
    transform-origin: left;
  }

  .section-title {
    margin-top: 0.375rem;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .squiggle {
    position: relative;
    display: inline-block;
  }

  .squiggle svg {
    position: absolute;
    left: 0;
    bottom: -0.15em;
    width: 100%;
    height: 0.3em;
    fill: none;
    stroke: var(--pop-red);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 260;
    stroke-dashoffset: 260;
    transition: stroke-dashoffset 1s 300ms cubic-bezier(0.65, 0, 0.35, 1);
  }

  :global(.is-visible) .squiggle svg,
  :global(html:not(.js)) .squiggle svg { stroke-dashoffset: 0; }

  .section-lede {
    margin-top: 1rem;
    font-size: 1.125rem;
    color: var(--color-muted);
  }

  .section-lede a {
    color: var(--color-ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--pop-pink);
    text-decoration-thickness: 3px;
    text-underline-offset: 4px;
  }

  .grid {
    display: grid;
    gap: 2.5rem 2rem;
  }

  @media (min-width: 44rem) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 64rem) {
    .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  :global(html.party main) {
    animation: party-hue 1.2s linear infinite;
  }

  :global(html.party [data-sticker]),
  :global(html.party .stat),
  :global(html.party .card) {
    animation: party-wiggle 0.35s ease-in-out infinite alternate;
  }

  @keyframes party-hue {
    to { filter: hue-rotate(360deg); }
  }

  @keyframes party-wiggle {
    from { transform: rotate(-3deg); }
    to { transform: rotate(3deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .squiggle svg { stroke-dashoffset: 0; transition: none; }
  }
</style>
