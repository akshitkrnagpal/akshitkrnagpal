---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { featured, more } from "../data/projects";

const bio =
  "Senior full-stack engineer, now building AI agents, evals, and developer tools.";

// Paths from simple-icons.
const socials = [
  {
    label: "GitHub",
    href: "https://github.com/akshitkrnagpal",
    path: "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12",
  },
  {
    label: "LinkedIn",
    href: "https://linkedin.com/in/akshitkrnagpal",
    path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
  },
  {
    label: "X",
    href: "https://x.com/akshit_io",
    path: "M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z",
  },
];
---

<Layout>
  <a class="skip-link" href="#main">
    Skip to content
  </a>
  <header class="site-header">
    <nav class="shell navbar" aria-label="Site">
      <a href="#top" class="wordmark" aria-label="Akshit Kr Nagpal, home">
        akshit<span aria-hidden="true">✳</span>
      </a>
      <div class="nav-links">
        <a href="#projects">My projects</a>
        <a href="#contact">
          Say hello <span aria-hidden="true">↗</span>
        </a>
      </div>
    </nav>
  </header>

  <main id="main">
    <section id="top" class="shell hero" aria-labelledby="hero-title">
      <div class="hero-copy animate-fade-up">
        <h1 id="hero-title" class="eyebrow">
          <span class="hello-dot" aria-hidden="true"></span> Hey, I'm Akshit Kr
          Nagpal
        </h1>
        <p class="display">
          I make
          <br />
          useful things<span class="period">.</span>
          <br />
          <em>And fun ones.</em>
        </p>
        <p class="bio">{bio}</p>
        <div class="hero-actions">
          <a class="button" href="#projects">
            Explore my projects <span aria-hidden="true">↘</span>
          </a>
          <a
            class="text-link"
            href="https://github.com/akshitkrnagpal"
            target="_blank"
            rel="noopener noreferrer"
          >
            Browse my code <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="desk animate-fade-in delay-2">
        <span class="desk-orbit" aria-hidden="true"></span>
        <div class="terminal-note" aria-hidden="true">
          <div class="terminal-bar">
            <span aria-hidden="true">● ● ●</span>
            <span>on my workbench</span>
          </div>
          <div class="terminal-content">
            <span class="code-muted">// things I build</span>
            <br />
            <span class="code-purple">AI agents &amp; evals</span>
            <br />
            <span class="code-lime">CLI + MCP tools</span>
            <br />
            <span class="code-muted">Cloudflare Workers</span>
          </div>
        </div>
        <figure class="photo-note">
          <span class="tape" aria-hidden="true"></span>
          <img
            src="https://avatars.githubusercontent.com/u/15872348?size=480"
            alt="Akshit Kr Nagpal"
            width="240"
            height="240"
            fetchpriority="high"
          />
          <figcaption>
            the human behind the code <span aria-hidden="true">↖</span>
          </figcaption>
        </figure>
        <div class="idea-note" aria-hidden="true">
          <span>✳</span>
          <p>
            Little apps.
            <br />
            Big curiosity.
          </p>
          <span class="note-caption">iOS · watchOS · macOS</span>
        </div>
        <span class="desk-label" aria-hidden="true">
          a work in progress, always
        </span>
      </div>
    </section>

    <section
      id="projects"
      class="shell projects"
      aria-labelledby="projects-title"
    >
      <div class="section-heading">
        <div>
          <p class="eyebrow">The things I've shipped</p>
          <h2 id="projects-title">
            Made with <em>curiosity.</em>
          </h2>
        </div>
        <button type="button" class="surprise-button" data-surprise hidden>
          <span aria-hidden="true">⚄</span> Pick one for me
        </button>
      </div>
      <p class="project-intro">
        AI evals, tiny apps, and tools for the everyday. Take a look around.
      </p>
      <p class="sr-only" data-pick-announcement role="status"></p>
      <div class="project-grid">
        {featured.map((project, i) => (
          <ProjectCard project={project} index={i} />
        ))}
      </div>
    </section>

    <section class="shell toolbox" aria-labelledby="more-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">There's more in the drawer</p>
          <h2 id="more-title">
            Little apps. <em>Handy tools.</em>
          </h2>
        </div>
        <span class="drawer-count">
          {more.length} more to explore <span aria-hidden="true">↙</span>
        </span>
      </div>
      <ul class="tool-list">
        {more.map((project, i) => (
          <li class="row">
            <span class="row-number" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <div class="row-copy">
              <a
                href={project.links[0].href}
                target="_blank"
                rel="noopener noreferrer"
                class="row-name"
              >
                {project.name}
              </a>
              <p>{project.description}</p>
            </div>
            <span class="row-tag">{project.tag}</span>
            <div class="row-links">
              {project.links.map((link) => (
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${project.name}: ${link.label}`}
                >
                  {link.label}
                  <span aria-hidden="true"> ↗</span>
                </a>
              ))}
            </div>
          </li>
        ))}
      </ul>
      <p class="github-note">
        Still curious? There's more on{" "}
        <a
          href="https://github.com/akshitkrnagpal"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub <span aria-hidden="true">↗</span>
        </a>
        .
      </p>
    </section>
  </main>

  <footer id="contact" class="shell footer">
    <div class="contact-card">
      <span class="footer-flower" aria-hidden="true">
        ✳
      </span>
      <div>
        <p class="eyebrow">Ideas welcome</p>
        <h2>
          Let's talk <em>shop.</em>
        </h2>
        <p>Building something? I'd love to hear about it.</p>
      </div>
      <div class="social-links">
        {socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d={s.path} />
            </svg>
            {s.label}
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
    <div class="footer-bottom">
      <span>Akshit Kr Nagpal</span>
      <span>Built with curiosity. And Astro.</span>
      <a href="#top">
        Back to top <span aria-hidden="true">↑</span>
      </a>
    </div>
  </footer>
</Layout>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-surprise]");
  const projects = Array.from(
    document.querySelectorAll<HTMLElement>("[data-project]"),
  );
  let lastPick = -1;
  if (button && projects.length > 1) {
    button.hidden = false;
    button.addEventListener("click", () => {
      const offset = 1 + Math.floor(Math.random() * (projects.length - 1));
      lastPick =
        lastPick < 0
          ? Math.floor(Math.random() * projects.length)
          : (lastPick + offset) % projects.length;
      projects.forEach((project) => project.removeAttribute("data-picked"));
      const project = projects[lastPick];
      project.setAttribute("data-picked", "");
      project.scrollIntoView({
        behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches
          ? "instant"
          : "smooth",
        block: "center",
      });
      project
        .querySelector<HTMLAnchorElement>("h3 a")
        ?.focus({ preventScroll: true });
      const announcement = document.querySelector("[data-pick-announcement]");
      if (announcement)
        announcement.textContent = `Try ${project.dataset.project}. Your project pick is ready.`;
    });
  }
</script>

<style>
  .shell {
    width: min(1120px, calc(100% - 96px));
    margin-inline: auto;
  }
  .site-header {
    border-bottom: 1px solid var(--color-border);
  }
  .navbar {
    height: 88px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-right: 60px;
  }
  .wordmark {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    font-weight: 700;
    font-size: 1.65rem;
    letter-spacing: -1.5px;
  }
  .wordmark span {
    color: var(--color-accent);
    font-size: 2rem;
    line-height: 1;
  }
  .nav-links {
    display: flex;
    gap: 32px;
    font-size: 0.875rem;
    font-weight: 500;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  .nav-links a:hover,
  .text-link:hover,
  .row a:hover,
  .github-note a:hover,
  .footer-bottom a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .hero {
    overflow-x: clip;
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 40px;
    align-items: center;
    padding-block: 88px 104px;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }
  .hello-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 4px var(--color-coral-soft);
  }
  .display {
    font-size: clamp(3.5rem, 6.6vw, 5.5rem);
    line-height: 1.02;
    font-weight: 600;
    letter-spacing: -0.065em;
    margin-block: 26px;
  }
  .display em {
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: -0.025em;
    color: var(--color-accent);
  }
  .period {
    color: var(--color-accent);
  }
  .bio {
    max-width: 400px;
    font-size: 1rem;
    color: var(--color-muted);
    line-height: 1.75;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 32px;
    flex-wrap: wrap;
  }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 50px;
    padding: 12px 20px;
    background: #fa937b;
    color: #292621;
    border: 1px solid #292621;
    border-radius: 10px;
    font-size: 0.875rem;
    font-weight: 500;
    box-shadow: 3px 3px 0 var(--color-shadow);
    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }
  .button:hover {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 var(--color-shadow);
  }
  .text-link {
    font-size: 0.875rem;
  }
  .desk {
    position: relative;
    min-width: 0;
    height: 440px;
  }
  .desk-orbit {
    position: absolute;
    width: 360px;
    height: 360px;
    inset: 42px auto auto 40px;
    border: 1px dashed var(--color-border-strong);
    border-radius: 50%;
  }
  .terminal-note {
    position: absolute;
    width: 282px;
    top: 30px;
    left: 0;
    transform: rotate(-7deg);
    border: 1px solid #444144;
    background: #252329;
    color: #f9f5ef;
    border-radius: 12px;
    box-shadow: 6px 8px 0 var(--color-shadow);
  }
  .terminal-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    font:
      0.7rem ui-monospace,
      monospace;
    color: #c4bfca;
    border-bottom: 1px solid #454049;
  }
  .terminal-bar span:first-child {
    color: #f1a19a;
    letter-spacing: 3px;
  }
  .terminal-content {
    font-family: ui-monospace, monospace;
    display: block;
    padding: 18px;
    font-size: 0.8rem;
    line-height: 1.9;
  }
  .code-muted {
    color: #bab4c3;
  }
  .code-purple {
    color: #d5b9fc;
  }
  .code-lime {
    color: #d8eca0;
  }
  .photo-note {
    position: absolute;
    top: 112px;
    right: 32px;
    width: 216px;
    padding: 12px 12px 15px;
    background: #fffcf4;
    color: #292621;
    transform: rotate(8deg);
    border: 1px solid #d8d3c8;
    box-shadow: 6px 8px 0 var(--color-shadow);
  }
  .photo-note img {
    display: block;
    width: 100%;
    height: 198px;
    object-fit: cover;
  }
  .photo-note figcaption {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.2rem;
    line-height: 1.2;
    padding-top: 14px;
    text-align: center;
  }
  .tape {
    position: absolute;
    width: 80px;
    height: 26px;
    top: -14px;
    left: 70px;
    background: #d6c7edb3;
    transform: rotate(-4deg);
  }
  .idea-note {
    position: absolute;
    left: 26px;
    bottom: 36px;
    width: 210px;
    padding: 20px;
    background: #e0ebac;
    color: #292f1d;
    transform: rotate(-4deg);
    border: 1px solid #b6c381;
    border-radius: 3px;
    box-shadow: 5px 6px 0 var(--color-shadow);
  }
  .idea-note > span:first-child {
    font-size: 2rem;
    line-height: 1;
  }
  .idea-note p {
    font-size: 1.2rem;
    line-height: 1.25;
    font-weight: 600;
    letter-spacing: -0.04em;
    margin-block: 10px;
  }
  .note-caption {
    font-size: 0.72rem;
  }
  .desk-label {
    position: absolute;
    bottom: 0;
    right: 24px;
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-style: italic;
    color: var(--color-muted);
    transform: rotate(-5deg);
  }
  .projects,
  .toolbox,
  .footer {
    scroll-margin-top: 32px;
  }
  .projects {
    padding-bottom: 92px;
  }
  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
  }
  .section-heading .eyebrow {
    color: var(--color-muted);
    margin-bottom: 10px;
  }
  h2 {
    font-size: clamp(2rem, 3.6vw, 3rem);
    letter-spacing: -0.055em;
    line-height: 1.15;
    font-weight: 500;
  }
  h2 em {
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: -0.015em;
  }
  .surprise-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 10px 16px;
    min-height: 44px;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    font-size: 0.8rem;
    cursor: pointer;
    background: var(--color-surface);
    color: var(--color-ink);
    white-space: nowrap;
    transition: background 180ms ease;
  }
  .surprise-button[hidden] {
    display: none;
  }
  .surprise-button span {
    font-size: 1.3rem;
    line-height: 1;
  }
  .surprise-button:hover {
    background: var(--color-lime-soft);
  }
  .project-intro {
    font-size: 0.9375rem;
    color: var(--color-muted);
    margin-block: 18px 32px;
  }
  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
  }
  .toolbox {
    padding-top: 48px;
    padding-bottom: 72px;
    border-top: 1px solid var(--color-border-strong);
  }
  .drawer-count {
    font-size: 0.8rem;
    color: var(--color-muted);
    white-space: nowrap;
  }
  .tool-list {
    margin-top: 32px;
    list-style: none;
  }
  .row {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr) 155px 200px;
    align-items: center;
    gap: 20px;
    padding: 20px 8px;
    border-bottom: 1px solid var(--color-border);
    border-radius: 8px;
    transition: background 180ms ease;
  }
  .row:hover {
    background: var(--color-lavender-soft);
  }
  .row-number {
    font:
      0.7rem ui-monospace,
      monospace;
    color: var(--color-muted);
  }
  .row-name {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .row p {
    font-size: 0.8rem;
    color: var(--color-muted);
    margin-top: 3px;
  }
  .row-tag {
    justify-self: start;
    font-size: 0.72rem;
    color: var(--color-ink);
    background: var(--color-lime-soft);
    padding: 4px 8px;
    border-radius: 6px;
  }
  .row-links {
    display: flex;
    gap: 6px 16px;
    justify-content: end;
    flex-wrap: wrap;
    font-size: 0.75rem;
  }
  .row-links a {
    min-height: 32px;
    display: inline-flex;
    align-items: center;
    gap: 3px;
    white-space: nowrap;
  }
  .github-note {
    margin-top: 28px;
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .github-note a {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .footer {
    padding-bottom: 24px;
  }
  .contact-card {
    display: grid;
    grid-template-columns: 60px minmax(0, 1fr) auto;
    align-items: center;
    gap: 32px;
    padding: 40px;
    border: 1px solid var(--color-border-strong);
    border-radius: 20px;
    background: var(--color-lavender-soft);
  }
  .footer-flower {
    color: var(--color-accent);
    font-size: 5rem;
    line-height: 1;
  }
  .contact-card .eyebrow {
    margin-bottom: 8px;
  }
  .contact-card h2 {
    font-size: 2.75rem;
  }
  .contact-card p:last-child {
    color: var(--color-muted);
    font-size: 0.875rem;
    margin-top: 12px;
  }
  .social-links {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .social-links a {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    font-size: 0.875rem;
  }
  .social-links a > span {
    margin-left: 12px;
  }
  .social-links a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .social-links svg {
    width: 15px;
    height: 15px;
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 28px;
    color: var(--color-muted);
    font-size: 0.7rem;
  }
  .skip-link {
    position: fixed;
    top: 8px;
    left: 8px;
    z-index: 60;
    padding: 12px;
    background: var(--color-ink);
    color: var(--color-paper);
    transform: translateY(-150%);
  }
  .skip-link:focus {
    transform: none;
  }
  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 5px;
  }
  @media (max-width: 1000px) {
    .shell {
      width: calc(100% - 64px);
    }
    .hero {
      gap: 24px;
    }
    .desk {
      transform: scale(0.88);
      transform-origin: center;
    }
    .photo-note {
      right: 24px;
    }
    .row {
      grid-template-columns: 24px minmax(0, 1fr) 180px;
      gap: 16px;
    }
    .row-tag {
      grid-column: 2;
    }
    .row-links {
      grid-column: 3;
      grid-row: 1 / 3;
    }
  }
  @media (max-width: 760px) {
    .shell {
      width: calc(100% - 40px);
    }
    .navbar {
      height: 76px;
      padding-right: 48px;
