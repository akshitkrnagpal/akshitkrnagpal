---
import Layout from "../layouts/Layout.astro";

interface ProjectLink {
  label: string;
  href: string;
}

interface Project {
  name: string;
  eyebrow: string;
  description: string;
  label: string;
  image?: string;
  links: ProjectLink[];
}

interface ProjectSection {
  id: string;
  title: string;
  description: string;
  featured?: boolean;
  projects: Project[];
  tools?: { name: string; description: string; links: ProjectLink[] }[];
}

