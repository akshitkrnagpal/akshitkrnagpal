---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { featured, more } from "../data/projects";
---

<Layout
  title="Projects | Akshit Kr Nagpal"
  description="Products and open-source developer tools built by Akshit Kr Nagpal."
>
  <main class="px-6 md:px-12 pb-20">
    <nav class="page-nav max-w-6xl mx-auto flex items-center animate-fade-in">
      <a href="/" class="flex items-center gap-3 text-sm font-medium hover:opacity-70 transition-opacity">
        <img
          src="https://avatars.githubusercontent.com/u/15872348"
          alt=""
          width="32"
          height="32"
          class="w-8 h-8 rounded-full object-cover"
          style="view-transition-name: avatar"
        />
        Akshit Kr Nagpal
      </a>
    </nav>

    <div class="max-w-6xl mx-auto">
      <header class="pt-8 md:pt-12 mb-12 md:mb-16 max-w-2xl">
        <h1 class="text-5xl md:text-6xl leading-none mb-4 animate-fade-up" style="font-family: var(--font-display);">Projects</h1>
        <p class="text-base md:text-lg leading-relaxed text-[var(--color-muted)] animate-fade-up delay-1">
          Products I run and open-source tools I maintain, spanning AI evals, commerce, publishing, search, developer infrastructure, and mobile.
        </p>
      </header>

      <div class="grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((project, i) => <ProjectCard project={project} index={i} />)}
      </div>

      <section class="mt-24" aria-labelledby="more-title">
        <h2 id="more-title" class="text-sm tracking-[0.18em] uppercase font-medium text-[var(--color-muted)] mb-4">More apps &amp; tools</h2>
        <ul class="border-t border-[var(--color-border)]">
          {more.map((project) => (
            <li class="row">
              <a href={project.links[0].href} target="_blank" rel="noopener noreferrer" class="row-name">{project.name}</a>
              <p>{project.description}</p>
              <span class="row-tag">{project.tag}</span>
              <div class="row-links">
                {project.links.map((link) => (
                  <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={`${project.name}: ${link.label}`}>
                    {link.label}<span aria-hidden="true"> ↗</span>
                  </a>
                ))}
              </div>
            </li>
          ))}
        </ul>
      </section>

      <p class="mt-16 text-center text-sm text-[var(--color-muted)]">
        Everything else lives on <a href="https://github.com/akshitkrnagpal" target="_blank" rel="noopener noreferrer" class="text-[var(--color-ink)] underline underline-offset-4">GitHub</a>.
      </p>
    </div>
  </main>
</Layout>

<style>
  .row {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr) 7rem 10rem;
    align-items: center;
    gap: 1rem;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.875rem;
  }

  .row-name { font-weight: 500; }
  .row p { color: var(--color-muted); }
  .row-tag { font-size: 0.75rem; color: var(--color-muted); }
  .row-links { display: flex; gap: 1rem; justify-content: end; font-size: 0.8125rem; }
  .row a { text-decoration: none; }
  .row a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .row a:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; border-radius: 2px; }

  @media (max-width: 43.99rem) {
    .row { grid-template-columns: minmax(0, 1fr) auto; gap: 0.25rem 1rem; }
    .row p { grid-column: 1 / -1; grid-row: 2; }
    .row-tag { display: none; }
  }
</style>
