---
import Layout from "../layouts/Layout.astro";
import ThemeToggle from "../components/ThemeToggle.astro";

const githubRepositories = [
  "typesensekit/typesensekit",
  "offerkit/offerkit",
  "prosewire/prosewire",
  "akshitkrnagpal/edgepush",
  "akshitkrnagpal/revcat",
  "akshitkrnagpal/namescout",
  "open-placeholder/open-placeholder",
  "akshitkrnagpal/secret-desk",
  "akshitkrnagpal/env-doctor",
] as const;

const githubHeaders: Record<string, string> = {
  Accept: "application/vnd.github+json",
  "X-GitHub-Api-Version": "2022-11-28",
};

if (import.meta.env.GITHUB_TOKEN) {
  githubHeaders.Authorization = `Bearer ${import.meta.env.GITHUB_TOKEN}`;
}

const githubStars = Object.fromEntries(
  await Promise.all(
    githubRepositories.map(async (repository) => {
      try {
        const response = await fetch(`https://api.github.com/repos/${repository}`, {
          headers: githubHeaders,
        });

        if (!response.ok) {
          console.warn(`Could not fetch GitHub stars for ${repository}: ${response.status}`);
          return [repository, null] as const;
        }

        const data = (await response.json()) as { stargazers_count: number };
        return [repository, data.stargazers_count] as const;
      } catch (error) {
        console.warn(`Could not fetch GitHub stars for ${repository}`, error);
        return [repository, null] as const;
      }
    }),
  ),
) as Record<string, number | null>;

const featuredProjects = [
  {
    name: "PromptLens",
    eyebrow: "AI regression detection",
    description:
      "Compares prompt and model changes with a known-good baseline, shows which test cases regressed, and records evidence for release decisions.",
    tags: ["LLM Evals", "Regression Testing", "Release Decisions"],
    labels: ["Active", "Early access"],
    image: "https://www.promptlens.io/icon-512.png",
    repo: null,
    links: [{ label: "Visit", href: "https://www.promptlens.io", primary: true }],
  },
  {
    name: "OfferKit",
    eyebrow: "Self-hostable promotion engine",
    description:
      "A self-hostable engine for coupons, loyalty, gift cards, referrals, and customer segments, with tools built for AI agents.",
    tags: ["Commerce", "Promotions", "MCP"],
    labels: ["Active", "Open Source", "Self-hostable"],
    image: "https://raw.githubusercontent.com/offerkit/offerkit/main/apps/web/public/icon.png",
    repo: "offerkit/offerkit",
    links: [
      { label: "Visit", href: "https://offerkit.dev", primary: true },
      { label: "GitHub", href: "https://github.com/offerkit/offerkit" },
    ],
  },
  {
    name: "Prosewire",
    eyebrow: "Publishing for existing websites",
    description:
      "Open-source publishing that adds a full blog to an existing website. Use native Next.js or Astro routes, embed it anywhere, self-host the stack, or use Prosewire Cloud.",
    tags: ["Publishing", "Next.js & Astro", "MCP"],
    labels: ["Active", "Open Source", "Self-hostable"],
    image: "https://prosewire.com/icon.png",
    repo: "prosewire/prosewire",
    links: [
      { label: "Visit", href: "https://prosewire.com", primary: true },
      { label: "Demo", href: "https://demo.prosewire.com" },
      { label: "GitHub", href: "https://github.com/prosewire/prosewire" },
    ],
  },
  {
    name: "OpenPlaceholder",
    eyebrow: "Placeholder images on demand",
    description:
      "A fast, customizable placeholder image service for mockups, prototypes, docs, and social previews. Use the hosted API or deploy your own.",
    tags: ["Image API", "Edge Runtime", "Self-hostable"],
    labels: ["Active", "Open Source", "Self-hostable"],
    image: "https://www.openplaceholder.com/512/OP",
    repo: "open-placeholder/open-placeholder",
    links: [
      { label: "Visit", href: "https://www.openplaceholder.com", primary: true },
      { label: "GitHub", href: "https://github.com/open-placeholder/open-placeholder" },
    ],
  },
  {
    name: "TypesenseKit",
    eyebrow: "Typesense CLI & MCP server",
    description:
      "95 typed Typesense operations for humans and AI agents—one CLI and MCP server, read-only by default.",
    tags: ["Typesense", "CLI", "MCP", "95 Operations"],
    labels: ["Active", "Open Source"],
    image: "https://typesensekit.vercel.app/images/typesensekit-robot-favicon-180.png",
    repo: "typesensekit/typesensekit",
    links: [
      { label: "Docs", href: "https://typesensekit.vercel.app", primary: true },
      { label: "GitHub", href: "https://github.com/typesensekit/typesensekit" },
    ],
  },
  {
    name: "EdgePush",
    eyebrow: "Open-source push notifications",
    description:
      "Mobile push notifications on Cloudflare Workers, with your own APNs and FCM credentials. Use the hosted tier or self-host it.",
    tags: ["Push Notifications", "Cloudflare Workers", "AGPL-3.0"],
    labels: ["Stable", "Open Source", "Self-hostable"],
    icon: "dot",
    iconBg: "#000000",
    iconText: "",
    iconColor: "#FF6B1A",
    repo: "akshitkrnagpal/edgepush",
    links: [
      { label: "Visit", href: "https://edgepush.dev", primary: true },
      { label: "GitHub", href: "https://github.com/akshitkrnagpal/edgepush" },
    ],
  },
  {
    name: "HookBell",
    eyebrow: "Instant webhook push notifications",
    description:
      "Turns Stripe, Clerk, and Supabase webhooks into readable phone notifications for events such as signups, payments, and churn.",
    tags: ["Webhooks", "Developer Tools", "Mobile"],
    labels: ["Production"],
    image: "https://hookbell.com/icon-512.png",
    repo: null,
    links: [
      { label: "Visit", href: "https://hookbell.com", primary: true },
      { label: "App Store", href: "https://apps.apple.com/us/app/hookbell/id6760628465" },
    ],
  },
];

const featured = featuredProjects.map((project) => ({
  ...project,
  stars: project.repo ? githubStars[project.repo] : null,
}));

const smallerProjects = [
  {
    name: "namescout",
    description:
      "Check product-name availability across domains, npm package and organization namespaces, and GitHub handles from one command.",
    tags: ["Go", "CLI", "Developer Tools"],
    repo: "akshitkrnagpal/namescout",
    href: "https://github.com/akshitkrnagpal/namescout",
  },
  {
    name: "revcat",
    description:
      "RevenueCat CLI with full v2 API coverage, OAuth login, and per-repo project context for agents and sandboxes.",
    tags: ["Go", "CLI", "RevenueCat"],
    repo: "akshitkrnagpal/revcat",
    href: "https://github.com/akshitkrnagpal/revcat",
    secondaryHref: "https://revcat.vercel.app",
    secondaryLabel: "Docs",
  },
  {
    name: "secret-desk",
    description:
      "Browser-based editor for Kubernetes secrets, modeled after Vercel's environment variable workflow.",
    tags: ["Kubernetes", "DevOps"],
    repo: "akshitkrnagpal/secret-desk",
    href: "https://github.com/akshitkrnagpal/secret-desk",
  },
  {
    name: "env-doctor",
    description:
      "Audits .env files to catch invalid syntax, missing values, and common configuration mistakes.",
    tags: ["CLI", "Developer Tools"],
    repo: "akshitkrnagpal/env-doctor",
    href: "https://github.com/akshitkrnagpal/env-doctor",
  },
];

const smaller = smallerProjects.map((project) => ({
  ...project,
  stars: githubStars[project.repo],
}));
---

<Layout
  title="Projects – Akshit Kr Nagpal"
  description="Products and open-source developer tools built by Akshit Kr Nagpal."
>
  <main class="min-h-dvh relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.012] pointer-events-none" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%270 0 256 256%27 xmlns=%27http://www.w3.org/2000/svg%27%3E%3Cfilter id=%27noise%27%3E%3CfeTurbulence type=%27fractalNoise%27 baseFrequency=%270.8%27 numOctaves=%274%27 stitchTiles=%27stitch%27/%3E%3C/filter%3E%3Crect width=%27100%25%27 height=%27100%25%27 filter=%27url(%23noise)%27/%3E%3C/svg%3E');"></div>
    <div class="absolute top-[-12rem] -right-32 w-[50vw] h-[50vw] max-w-[700px] max-h-[700px] rounded-full opacity-[0.035] blur-3xl" style="background: radial-gradient(circle, var(--color-accent) 0%, transparent 70%);"></div>

    <div class="relative z-10 min-h-dvh flex flex-col">
      <nav class="w-full px-5 md:px-10 lg:px-14 py-5 flex justify-between items-center animate-fade-in">
        <a href="/" class="text-sm tracking-wide font-medium transition-colors duration-300 hover:opacity-70 flex items-center gap-2" style="color: var(--color-ink);">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Back
        </a>
        <div class="flex items-center gap-4">
          <span class="hidden sm:inline text-xs tracking-[0.18em] uppercase font-medium" style="color: var(--color-muted);">Projects</span>
          <ThemeToggle />
        </div>
      </nav>

      <div class="flex-1 px-5 md:px-10 lg:px-14 pt-3 md:pt-5 pb-12">
        <div class="max-w-[86rem] mx-auto">
          <header class="grid lg:grid-cols-[minmax(0,0.72fr)_minmax(24rem,0.9fr)] lg:items-end gap-3 lg:gap-12 mb-7 md:mb-8">
            <div>
              <p class="text-[11px] tracking-[0.28em] uppercase mb-2 animate-fade-up" style="color: var(--color-muted);">Selected work</p>
              <h1 class="text-4xl md:text-5xl leading-none animate-fade-up delay-1" style="font-family: var(--font-display);">Things I've shipped</h1>
            </div>
            <p class="text-sm md:text-base leading-relaxed max-w-2xl animate-fade-up delay-2" style="color: var(--color-muted);">
              Products I run and open-source tools I maintain. Each solves a narrow problem, including LLM release testing and mobile push notifications.
            </p>
          </header>

          <div class="mb-3 flex items-center gap-4 animate-fade-up delay-2">
            <span class="text-[11px] tracking-[0.25em] uppercase font-medium" style="color: var(--color-muted);">Featured</span>
            <div class="flex-1 h-px" style="background: var(--color-border);"></div>
            <span class="text-[11px] tabular-nums" style="color: var(--color-muted);">{featured.length}</span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3 md:gap-4 mb-10 md:mb-12">
            {featured.map((project, index) => (
              <article class={`project-card group animate-fade-up delay-${Math.min(index + 3, 8)} border transition-all duration-300`}>
                <div class="p-4 md:p-5 flex flex-col h-full min-h-[16.5rem]">
                  <div class="flex items-start gap-3 mb-3">
                    <div class="w-11 h-11 rounded-lg overflow-hidden flex-shrink-0 flex items-center justify-center border" style={`background: ${project.iconBg || "transparent"}; border-color: var(--color-border);`}>
                      {project.image ? (
                        <img src={project.image} alt="" class="w-full h-full object-cover" />
                      ) : project.icon === "dot" ? (
                        <svg width="44" height="44" viewBox="0 0 44 44" aria-hidden="true">
                          <circle cx="22" cy="22" r="9" fill={project.iconColor} />
                        </svg>
                      ) : (
                        <span class="text-xl font-semibold tracking-tight" style={`color: ${project.iconColor}; font-family: ui-monospace, SFMono-Regular, Menlo, monospace;`}>{project.iconText}</span>
                      )}
                    </div>
                    <div class="min-w-0 flex-1 pt-0.5">
                      <div class="flex items-baseline justify-between gap-2">
                        <h2 class="text-xl md:text-2xl leading-none font-medium" style="font-family: var(--font-display);">{project.name}</h2>
                        {project.stars ? (
                          <span class="inline-flex items-center gap-1 text-[11px] tabular-nums flex-none" style="color: var(--color-muted);" aria-label={`${project.stars} GitHub stars`}>
                            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25z"/></svg>
                            {project.stars}
                          </span>
                        ) : null}
                      </div>
                      <p class="text-xs mt-1 truncate" style="color: var(--color-muted);">{project.eyebrow}</p>
                    </div>
                  </div>
                  <p class="text-[10px] tracking-[0.13em] uppercase mb-2" style="color: var(--color-accent);">{project.labels.join(" · ")}</p>
                  <p class="project-description text-sm leading-[1.55] mb-3 flex-1" style="color: var(--color-muted);">{project.description}</p>
                  <p class="text-[11px] leading-relaxed mb-3" style="color: var(--color-muted);">{project.tags.join(" · ")}</p>
                  <div class="flex flex-wrap items-center gap-x-4 gap-y-2 pt-3 border-t" style="border-color: var(--color-border);">
                    {project.links.map((link) => (
                      <a href={link.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs font-medium transition-colors duration-200 hover:text-[var(--color-accent)]" style={`color: var(${link.primary ? "--color-ink" : "--color-muted"});`}>
                        {link.label}
                        {link.primary ? (
                          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17 17 7M8 7h9v9"></path>
                          </svg>
                        ) : null}
                      </a>
                    ))}
                  </div>
                </div>
              </article>
            ))}
          </div>

          <div class="mb-3 flex items-center gap-4 animate-fade-up delay-5">
            <span class="text-[11px] tracking-[0.25em] uppercase font-medium" style="color: var(--color-muted);">Tools &amp; Experiments</span>
            <div class="flex-1 h-px" style="background: var(--color-border);"></div>
            <span class="text-[11px] tabular-nums" style="color: var(--color-muted);">{smaller.length}</span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3 md:gap-4 mb-8">
            {smaller.map((project, index) => (
              <article class={`project-card group animate-fade-up delay-${Math.min(index + 5, 8)} border transition-all duration-300`}>
                <div class="p-4 md:p-5 flex flex-col h-full">
                  <div class="flex items-center justify-between gap-3 mb-2">
                    <h2 class="text-lg md:text-xl leading-none font-medium" style="font-family: var(--font-display);">{project.name}</h2>
                    {project.stars ? (
                      <span class="inline-flex items-center gap-1 text-[11px] tabular-nums" style="color: var(--color-muted);" aria-label={`${project.stars} GitHub stars`}>
                        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25z"/></svg>
                        {project.stars}
                      </span>
                    ) : null}
                  </div>
                  <p class="text-sm leading-[1.55] mb-3 flex-1" style="color: var(--color-muted);">{project.description}</p>
                  <p class="text-[11px] mb-3" style="color: var(--color-muted);">{project.tags.join(" · ")}</p>
                  <div class="flex flex-wrap items-center gap-x-4 gap-y-2 pt-3 border-t" style="border-color: var(--color-border);">
                    <a href={project.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs font-medium transition-colors duration-200 hover:text-[var(--color-accent)]" style="color: var(--color-ink);">
                      GitHub
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17 17 7M8 7h9v9"></path>
                      </svg>
                    </a>
                    {project.secondaryHref ? (
                      <a href={project.secondaryHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs font-medium transition-colors duration-200 hover:text-[var(--color-accent)]" style="color: var(--color-muted);">
                        {project.secondaryLabel}
                      </a>
                    ) : null}
                  </div>
                </div>
              </article>
            ))}
          </div>

          <div class="flex justify-center animate-fade-up delay-8">
            <a href="https://github.com/akshitkrnagpal" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 px-5 py-2.5 text-sm font-medium border rounded-full transition-all duration-300 hover:bg-[var(--color-ink)] hover:text-[var(--color-paper)]" style="color: var(--color-ink); border-color: var(--color-border-strong);">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
              More on GitHub
            </a>
          </div>
        </div>
      </div>

      <div class="w-full h-1 bg-[var(--color-accent)] animate-fade-in delay-9"></div>
    </div>
  </main>
</Layout>

<style>
  .project-card {
    border-color: var(--color-border);
    background: var(--color-surface);
  }

  .project-card:hover {
    border-color: var(--color-border-strong);
    background: var(--color-surface-hover);
    transform: translateY(-2px);
  }

  .project-description {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card:hover {
      transform: none;
    }
  }
</style>
